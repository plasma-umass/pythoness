      [[Pythoness] Synthesized function: 
 

      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays.
          An SCS is a minimal-length string containing each string in the input words as a subsequence.
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from collections import Counter
          from itertools import permutations
    
          def is_subsequence(xs, ys):
              it = iter(ys)
              return all(x in it for x in xs)

          def get_letter_frequency(s):
              freq = [0] * 26
              for char in s:
                  freq[ord(char) - ord('a')] += 1
              return freq

          words = list(set(words))  # Remove duplicates for permutations
          all_supersequences = set()
          min_length = None
    
          for perm in permutations(words):
              scs = perm[0]
              for word in perm[1:]:
                  # Find the merge point
                  for i in range(len(scs) + 1):
                      if is_subsequence(word, scs[i:]):
                          scs = scs[:i] + word + scs[i + len(word) - len(word[i:]):]
                          break
              if min_length is None or len(scs) < min_length:
                  min_length = len(scs)
                  all_supersequences = {scs}
              elif len(scs) == min_length:
                  all_supersequences.add(scs)
    
          frequency_arrays = [get_letter_frequency(scs) for scs in sorted(all_supersequences)]
          return frequency_arrays
      ]
