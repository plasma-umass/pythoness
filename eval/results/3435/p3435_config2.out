      [[Pythoness] Synthesized function: 
       def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other
          and returns their frequency arrays. An SCS is a minimal-length string containing each string in the input words
          as a subsequence. The result is a 2D array where each sub-array represents the frequency of each lowercase
          English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import defaultdict, Counter
          import string

          def scs_length(x, y):
              m, n = len(x), len(y)
              dp = [[0] * (n + 1) for _ in range(m + 1)]
              for i in range(m + 1):
                  for j in range(n + 1):
                      if i == 0:
                          dp[i][j] = j
                      elif j == 0:
                          dp[i][j] = i
                      elif x[i - 1] == y[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = 1 + min(dp[i - 1][j], dp[i][j - 1])
              return dp[m][n]

          def merge(x, y):
              m, n = len(x), len(y)
              dp = [[''] * (n + 1) for _ in range(m + 1)]
              for i in range(m + 1):
                  for j in range(n + 1):
                      if i == 0:
                          dp[i][j] = y[:j]
                      elif j == 0:
                          dp[i][j] = x[:i]
                      elif x[i - 1] == y[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + x[i - 1]
                      else:
                          if len(dp[i - 1][j]) < len(dp[i][j - 1]):
                              dp[i][j] = dp[i - 1][j] + x[i - 1]
                          else:
                              dp[i][j] = dp[i][j - 1] + y[j - 1]
              return dp[m][n]

          min_length = float('inf')
          possible_scs = set()

          for perm in permutations(words):
              current_scs = perm[0]
              for i in range(1, len(perm)):
                  current_scs = merge(current_scs, perm[i])
              current_length = len(current_scs)
              if current_length < min_length:
                  min_length = current_length
                  possible_scs = {current_scs}
              elif current_length == min_length:
                  possible_scs.add(current_scs)

          unique_scs = set(''.join(sorted(scs)) for scs in possible_scs)
          frequency_list = []
          for scs in unique_scs:
              frequency = [scs.count(char) for char in string.ascii_lowercase]
              frequency_list.append(frequency)

          return frequency_list
      ]
