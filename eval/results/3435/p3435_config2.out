      def supersequences(words):
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from collections import defaultdict
          import itertools
    
          # Function to determine if s1 is a subsequence of s2
          def is_subsequence(s1, s2):
              it = iter(s2)
              return all(c in it for c in s1)

          # Computes the Shortest Common Supersequence for two sequences
          def scs(word1, word2):
              dp = [[0] * (len(word2) + 1) for _ in range(len(word1) + 1)]

              for i in range(1, len(word1) + 1):
                  dp[i][0] = i
              for j in range(1, len(word2) + 1):
                  dp[0][j] = j

              for i in range(1, len(word1) + 1):
                  for j in range(1, len(word2) + 1):
                      if word1[i - 1] == word2[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = min(dp[i - 1][j], dp[i][j - 1]) + 1

              # recover the scs (one of them)
              i, j = len(word1), len(word2)
              superseq = []
              while i > 0 and j > 0:
                  if word1[i - 1] == word2[j - 1]:
                      superseq.append(word1[i - 1])
                      i -= 1
                      j -= 1
                  elif dp[i - 1][j] < dp[i][j - 1]:
                      superseq.append(word1[i - 1])
                      i -= 1
                  else:
                      superseq.append(word2[j - 1])
                      j -= 1

              while i > 0:
                  superseq.append(word1[i - 1])
                  i -= 1
              while j > 0:
                  superseq.append(word2[j - 1])
                  j -= 1

              return ''.join(reversed(superseq))

          # Find all SCS
          candidate_scs = set()
          for permutation in itertools.permutations(words):
              scs_result = permutation[0]
              for word in permutation[1:]:
                  scs_result = scs(scs_result, word)
              candidate_scs.add(scs_result)

          # Filter to non-permuted SCS
          scs_set = defaultdict(list)
          for scs_result in candidate_scs:
              char_counts = tuple(scs_result.count(chr(i)) for i in range(ord('a'), ord('z') + 1))
              scs_set[char_counts].append(scs_result)

          # Create frequency array for distinct SCS
          frequency_arrays = list(scs_set.keys())

          return frequency_arrays

      ]
