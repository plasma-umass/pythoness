      [[Pythoness] Synthesized function: 
 

      def supersequences(words):
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import Counter

          def is_subsequence(x, y):
              it = iter(y)
              return all(c in it for c in x)

          def scs(x, y):
              if is_subsequence(x, y):
                  return y
              if is_subsequence(y, x):
                  return x

              dp = [[0] * (len(y) + 1) for _ in range(len(x) + 1)]
              for i in range(1, len(x) + 1):
                  for j in range(1, len(y) + 1):
                      if x[i - 1] == y[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

              result = []
              i, j = len(x), len(y)
              while i > 0 and j > 0:
                  if x[i - 1] == y[j - 1]:
                      result.append(x[i - 1])
                      i -= 1
                      j -= 1
                  elif dp[i - 1][j] >= dp[i][j - 1]:
                      result.append(x[i - 1])
                      i -= 1
                  else:
                      result.append(y[j - 1])
                      j -= 1

              while i > 0:
                  result.append(x[i - 1])
                  i -= 1
              while j > 0:
                  result.append(y[j - 1])
                  j -= 1

              return ''.join(reversed(result))

          candidate_scs = set()
          for perm in permutations(words):
              current_scs = perm[0]
              for word in perm[1:]:
                  current_scs = scs(current_scs, word)
              candidate_scs.add(current_scs)

          scs_set = set(candidate_scs)

          min_length = min(len(scs) for scs in scs_set)
          distinct_scs = [scs for scs in scs_set if len(scs) == min_length]

          frequency_arrays = []
          for scs in distinct_scs:
              counter = Counter(scs)
              frequency_array = [counter.get(chr(i), 0) for i in range(ord('a'), ord('z') + 1)]
              frequency_arrays.append(frequency_array)

          return frequency_arrays

      ]
