      [[Pythoness] Synthesized function: 
       def supersequences(words):
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import defaultdict, Counter

          def is_subsequence(small, big):
              it = iter(big)
              return all(c in it for c in small)

          def merge(a, b):
              i = j = 0
              result = []
              while i < len(a) and j < len(b):
                  if a[i] == b[j]:
                      result.append(a[i])
                      i += 1
                      j += 1
                  elif not is_subsequence(b[j:], a[i:]):
                      result.append(a[i])
                      i += 1
                  else:
                      result.append(b[j])
                      j += 1
              result.extend(a[i:])
              result.extend(b[j:])
              return ''.join(result)

          def scs_for_words(words):
              merged_sequence = words[0]
              for word in words[1:]:
                  merged_sequence = merge(merged_sequence, word)
              return merged_sequence

          all_scs = set()
          for perm in permutations(words):
              scs = scs_for_words(list(perm))
              all_scs.add(scs)

          def scs_to_freq_array(scs):
              counter = Counter(scs)
              return [counter.get(chr(ord('a') + i), 0) for i in range(26)]

          return [scs_to_freq_array(scs) for scs in all_scs]]
