       def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other
          and returns their frequency arrays. An SCS is a minimal-length string containing each string in the input words
          as a subsequence. The result is a 2D array where each sub-array represents the frequency of each lowercase
          English letter in a distinct SCS.
          """
          from itertools import permutations, product
          from collections import defaultdict
          import string

          def is_subsequence(x, y):
              it = iter(y)
              return all(c in it for c in x)

          all_letters = set(''.join(words))
          unique_permutations = set()
          scs_set = set()

          for perm in permutations(words):
              candidate = perm[0]
              for i in range(1, len(perm)):
                  for j in range(len(candidate) + 1):
                      new_candidate = candidate[:j] + perm[i] + candidate[j:]
                      if all(is_subsequence(w, new_candidate) for w in words):
                          candidate = new_candidate
                          break
              scs_set.add(candidate)

          frequency_dict = defaultdict(list)
          for scs in scs_set:
              if tuple(sorted(scs)) not in unique_permutations:
                  unique_permutations.add(tuple(sorted(scs)))
                  frequency = [scs.count(char) for char in string.ascii_lowercase]
                  frequency_dict[tuple(frequency)].append(scs)

          return [list(freq) for freq in frequency_dict.keys()]
      ]
