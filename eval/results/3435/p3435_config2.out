      [[Pythoness] Synthesized function: 
       def supersequences(words):
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import Counter

          def is_supersequence(scs, words):
              def is_subsequence(word, superseq):
                  it = iter(superseq)
                  return all(char in it for char in word)
              return all(is_subsequence(word, scs) for word in words)

          def generate_supersequence(perm):
              current_scs = perm[0]
              for word in perm[1:]:
                  if word in current_scs:
                      continue
                  # Add characters from `word` to `current_scs`
                  temp_scs = []
                  i, j = 0, 0
                  while i < len(current_scs) and j < len(word):
                      if current_scs[i] == word[j]:
                          temp_scs.append(current_scs[i])
                          i += 1
                          j += 1
                      else:
                          temp_scs.append(current_scs[i])
                          i += 1
                  temp_scs.extend(current_scs[i:])
                  temp_scs.extend(word[j:])
                  current_scs = ''.join(temp_scs)
              return current_scs

          all_supersequences = set()
          for perm in permutations(words):
              scs_candidate = generate_supersequence(perm)
              if is_supersequence(scs_candidate, words):
                  all_supersequences.add(scs_candidate)

          min_length = min(len(scs) for scs in all_supersequences)
          shortest_supersequences = [scs for scs in all_supersequences if len(scs) == min_length]

          def scs_to_freq_array(scs):
              counter = Counter(scs)
              return [counter.get(chr(ord('a') + i), 0) for i in range(26)]

          result = [scs_to_freq_array(scs) for scs in shortest_supersequences]
          result.sort()
          return result]
