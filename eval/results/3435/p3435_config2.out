      [[Pythoness] Synthesized function: 
       def supersequences(words):
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import Counter

          def is_subsequence(small, big):
              it = iter(big)
              return all(c in it for c in small)

          def generate_scs(words):
              if not words:
                  return ['']
              if len(words) == 1:
                  return words
              first, *rest = words
              scs_list = generate_scs(rest)
              new_scs = set()
              for scs in scs_list:
                  for i in range(len(scs) + 1):
                      candidate = scs[:i] + first + scs[i:]
                      if candidate not in new_scs and all(is_subsequence(word, candidate) for word in words):
                          new_scs.add(candidate)
              # Return only the shortest ones
              min_length = min(len(scs) for scs in new_scs)
              return [scs for scs in new_scs if len(scs) == min_length]

          all_scs = set()
          for perm in permutations(words):
              scs_for_perm = generate_scs(list(perm))
              all_scs.update(scs_for_perm)

          def scs_to_freq_array(scs):
              counter = Counter(scs)
              return [counter.get(chr(ord('a') + i), 0) for i in range(26)]

          unique_scs = set(tuple(scs_to_freq_array(scs)) for scs in all_scs)
          return [list(freq_arr) for freq_arr in unique_scs]]
