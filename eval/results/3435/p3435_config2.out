      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays.
          An SCS is a minimal-length string containing each string in the input words as a subsequence.
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations, combinations
          from collections import Counter

          def is_subsequence(x, y):
              it = iter(y)
              return all(c in it for c in x)

          def merge_sequences(a, b):
              i, j = 0, 0
              result = []
              while i < len(a) and j < len(b):
                  if a[i] == b[j]:
                      result.append(a[i])
                      i += 1
                      j += 1
                  else:
                      result.append(a[i]) if a[i] < b[j] else result.append(b[j])
                      i += a[i] < b[j]
                      j += a[i] >= b[j]
              result.extend(a[i:])
              result.extend(b[j:])
              return ''.join(result)

          def generate_shortest_supersequence(words):
              shortest_scs = None
              min_length = float('inf')

              # Generate all permutations of the words
              for perm in permutations(words):
                  scs = perm[0]
                  for word in perm[1:]:
                      scs = merge_sequences(scs, word)
                  if len(scs) < min_length:
                      min_length = len(scs)
                      shortest_scs = [scs]
                  elif len(scs) == min_length and scs not in shortest_scs:
                      shortest_scs.append(scs)

              return shortest_scs

          scs_list = generate_shortest_supersequence(words)
          result = []
          for scs in scs_list:
              letter_counts = [0] * 26
              for char in scs:
                  letter_counts[ord(char) - ord('a')] += 1
              result.append(letter_counts)

          return result
      ]
