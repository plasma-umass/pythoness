@given(st.lists(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1, max_size=10), min_size=1, max_size=5))
def property_test_1(words):
    # Test that the length of each SCS is at least as long as the longest input word
    result = supersequences(words)
    longest_word_length = max(map(len, words))
    for freq_array in result:
        assert sum(freq_array) >= longest_word_length
@given(st.lists(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1, max_size=5), 
                min_size=1, max_size=3))
def property_test_2(words):
    # Test that the SCS contains every letter in the original words’ character set at least once
    result = supersequences(words)
    original_chars = set(''.join(words))
    for freq_array in result:
        constructed_chars = {chr(i + 97) for i, count in enumerate(freq_array) if count > 0}
        assert original_chars.issubset(constructed_chars)
@given(st.lists(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1, max_size=6), min_size=1, max_size=4))
def property_test_3(words):
    # Check that the function is deterministic; same input gives same output
    result1 = supersequences(words)
    result2 = supersequences(words)
    assert result1 == result2
@given(st.lists(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1, max_size=5), min_size=1, max_size=5))
def property_test_4(words):
    # Test that all characters in input words appear in SCS frequency array
    result = supersequences(words)
    for word in words:
        for char in word:
            char_index = ord(char) - 97
            assert all(freq[char_index] > 0 for freq in result)

