      [[Pythoness] Synthesized function: 
 

      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import Counter

          def can_form_subsequence(scs, word):
              iter_scs = iter(scs)
              return all(char in iter_scs for char in word)

          def frequency_array(scs):
              freq = [0] * 26
              count = Counter(scs)
              for char, cnt in count.items():
                  freq[ord(char) - ord('a')] = cnt
              return freq

          # Start with the first word in the list and build up
          possible_sequences = set([''])
          for word in words:
              new_sequences = set()
              for seq in possible_sequences:
                  for i in range(len(seq) + 1):
                      new_seq = seq[:i] + word + seq[i:]
                      if all(can_form_subsequence(new_seq, w) for w in words):
                          new_sequences.add(new_seq)
              possible_sequences = new_sequences

          # Remove permutations of each sequence by sorting characters
          unique_sequences = set(''.join(sorted(seq)) for seq in possible_sequences)

          # Convert to frequency arrays
          frequency_arrays = [frequency_array(seq) for seq in unique_sequences]

          return frequency_arrays
      ]
