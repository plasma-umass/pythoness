@given(st.lists(st.text(min_size=1, max_size=5, alphabet=st.characters(blacklist_categories=('Cs',), min_codepoint=97, max_codepoint=122)), min_size=1, max_size=5))
def property_test_1(words):
    result = supersequences(words)
    # Every result must be a list of frequency arrays of lowercase English letters
    assert all(isinstance(freq, list) and len(freq) == 26 for freq in result)
@given(st.lists(st.text(min_size=1, max_size=5, alphabet='abc'), min_size=1, max_size=5))
def property_test_2(words):
    result = supersequences(words)
    # Ensure SCS can form each word from the input list
    for scs in result:
        total_freq = sum(scs)
        # The total character count should be at least the number of words
        assert total_freq >= len(words)
@given(st.lists(st.text(min_size=1, alphabet=st.characters(blacklist_categories=('Cs',), min_codepoint=97, max_codepoint=122)), min_size=1))
def property_test_3(words):
    result = supersequences(words)
    # The result should not be empty
    assert len(result) > 0
    # For the words with single elements, scs length should be at most the size of unique individual characters
    if len(words) == 1:
        assert len(result) == 1
        # Frequency array sum must be equal to the length of the word
        assert sum(result[0]) == len(words[0])
@given(st.lists(st.text(min_size=1, alphabet='abcd'), min_size=2, max_size=3))
def property_test_4(words):
    result = supersequences(words)
    # Ensure that there are no identical frequency arrays by ensuring their sets do not have duplicates
    frequency_sets = [tuple(freq) for freq in result]
    assert len(frequency_sets) == len(set(frequency_sets))

