      def supersequences(words: list) -> list:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import Counter

          def is_subsequence(x, y):
              it = iter(y)
              return all(c in it for c in x)

          def merge_two_strings(a, b):
              la, lb = len(a), len(b)
              i, j = 0, 0
              scs = []
              while i < la or j < lb:
                  if i < la and j < lb and a[i] == b[j]:
                      scs.append(a[i])
                      i += 1
                      j += 1
                  elif j < lb and (i == la or b[j] not in a[i:]):
                      scs.append(b[j])
                      j += 1
                  else:
                      scs.append(a[i])
                      i += 1
              return ''.join(scs)

          def find_shortest_common_supersequences(word_list):
              shortest_length = float('inf')
              scs_set = set()

              for perm in permutations(word_list):
                  scs_result = perm[0]
                  for word in perm[1:]:
                      scs_result = merge_two_strings(scs_result, word)
                  if len(scs_result) < shortest_length:
                      shortest_length = len(scs_result)
                      scs_set = {scs_result}
                  elif len(scs_result) == shortest_length:
                      scs_set.add(scs_result)

              return scs_set

          scs_set = find_shortest_common_supersequences(words)

          def make_frequency_array(s):
              freq = [0] * 26
              for letter in s:
                  freq[ord(letter) - ord('a')] += 1
              return freq

          frequency_arrays = [make_frequency_array(scs) for scs in scs_set]
          return frequency_arrays

      ]
