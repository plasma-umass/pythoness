@given(st.lists(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1, max_size=5), min_size=1, max_size=5))
def property_test_1(words):
    # The length of any SCS should be at least the length of the largest word and at most the sum of all word lengths
    result = supersequences(words)
    for scs_freq in result:
        scs_length = sum(scs_freq)
        assert scs_length >= max(len(word) for word in words)
        assert scs_length <= sum(len(word) for word in words)
@given(st.lists(st.text(min_size=1, max_size=5), min_size=1, max_size=3))
def property_test_2(words):
    # The frequency array should contain only non-negative integers
    result = supersequences(words)
    for scs_freq in result:
        assert all(f >= 0 for f in scs_freq)
@given(st.lists(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1), min_size=2, max_size=4))
def property_test_3(words):
    # For each character in each input word, the frequency in at least one SCS should be at least as many as in the word
    result = supersequences(words)
    for word in words:
        count = [0] * 26
        for c in word:
            count[ord(c) - ord('a')] += 1
        for scs_freq in result:
            assert all(scs_freq[i] >= count[i] for i in range(26))
@given(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1, max_size=5))
def property_test_4(word):
    # The SCS of a single word should be itself 
    result = supersequences([word])
    assert len(result) == 1
    scs = result[0]
    assert ''.join(chr(i + ord('a')) * scs[i] for i in range(26)) == word

