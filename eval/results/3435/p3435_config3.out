      [[Pythoness] Synthesized function: 
 

      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import Counter

          def is_subsequence(x, y):
              it = iter(y)
              return all(c in it for c in x)

          def scs_length(a, b):
              m, n = len(a), len(b)
              dp = [[0] * (n + 1) for _ in range(m + 1)]

              for i in range(1, m + 1):
                  for j in range(1, n + 1):
                      if a[i - 1] == b[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])

              return m + n - dp[m][n]

          def find_scs(strings):
              if not strings:
                  return ['']
              if len(strings) == 1:
                  return strings

              current_scs = set()
              for perm in permutations(strings):
                  scs = perm[0]
                  for string in perm[1:]:
                      pos = 0
                      for char in string:
                          pos = scs.find(char, pos) + 1 or len(scs)
                          if pos == len(scs):
                              scs += string[string.index(char):]
                              break
                      current_scs.add(scs)

              min_length = min(map(len, current_scs))
              minimal_scs = [scs for scs in current_scs if len(scs) == min_length]

              return minimal_scs

          scs_strings = find_scs(words)
          result = set()
          for scs in scs_strings:
              freq_array = [0] * 26
              for char in scs:
                  freq_array[ord(char) - ord('a')] += 1
              result.add(tuple(freq_array))

          return [list(frequencies) for frequencies in result]
      ]
