      [[Pythoness] Synthesized function: 
 

      def supersequences(words):
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays.
          An SCS is a minimal-length string containing each string in the input words as a subsequence.
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          def is_subsequence(x, y):
              """Check if x is a subsequence of y"""
              it = iter(y)
              return all(c in it for c in x)

          def generate_scs(words):
              """Generate one possible SCS for a list of words"""
              if not words:
                  return ''

              scs = words[0]
              for word in words[1:]:
                  for i in range(len(scs) + 1):
                      # Try to interleave word into scs at position i
                      candidate = scs[:i] + word + scs[i:]
                      if all(is_subsequence(w, candidate) for w in words):
                          scs = candidate
                          break
              return scs

          distinct_scs = set()
          # Generate all permutations of the input words
          for perm in permutations(words):
              scs = generate_scs(perm)
              distinct_scs.add(scs)

          # Filter permutations of the same sequence
          unique_scs = set()
          for scs in distinct_scs:
              # Calculate frequency array
              freq = [0] * 26
              for char in scs:
                  freq[ord(char) - ord('a')] += 1
              unique_scs.add(tuple(freq))

          return [list(freq) for freq in unique_scs]

      ]
