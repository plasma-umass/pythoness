      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from itertools import permutations
          from collections import Counter

          def is_subsequence(x, y):
              it = iter(y)
              return all(c in it for c in x)

          def scs_length(a, b):
              la, lb = len(a), len(b)
              dp = [[0] * (lb + 1) for _ in range(la + 1)]
              for i in range(la + 1):
                  for j in range(lb + 1):
                      if i == 0 or j == 0:
                          dp[i][j] = i + j
                      elif a[i - 1] == b[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = min(dp[i - 1][j], dp[i][j - 1]) + 1
              return dp[la][lb]

          def generate_scs(seqs):
              if not seqs:
                  return ""
              result = seqs[0]
              for i in range(1, len(seqs)):
                  lcs = scs_length(result, seqs[i])
                  matched_indices = [[-1] * len(result) for _ in range(len(seqs[i]))]
                  for j, char in enumerate(seqs[i]):
                      if char in result:
                          last_pos = result.index(char)
                          matched_indices[j][last_pos] = last_pos
                          for k in range(last_pos+1, len(result)):
                              if result[k] == char:
                                  matched_indices[j][last_pos] = k
                                  break
                  i, j, super_str = 0, 0, []
                  while i < len(result) or j < len(seqs[i]):
                      if i < len(result) and j < len(seqs[i]) and result[i] == seqs[i][j]:
                          super_str.append(result[i])
                          i += 1
                          j += 1
                      elif j < len(seqs[i]):
                          super_str.append(seqs[i][j])
                          j += 1
                      else:
                          super_str.append(result[i])
                          i += 1
                  result = ''.join(super_str)
              return result

          def scs_permutations(words):
              scs_words = set()
              for perm in permutations(words):
                  scs = generate_scs(list(perm))
                  scs_words.add(scs)
              return scs_words

          results = []
          scs_set = scs_permutations(words)
          for scs in scs_set:
              freq_array = [0] * 26
              for char, count in Counter(scs).items():
                  freq_array[ord(char) - ord('a')] = count
              results.append(freq_array)

          return results

      ]
