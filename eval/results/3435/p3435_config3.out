      [[Pythoness] Synthesized function: 
 

      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          import itertools
          from collections import defaultdict

          # Generate all permutations of indices
          def generate_permutations(words):
              indices = list(range(len(words)))
              return itertools.permutations(indices)

          # Generate all possible supersequences
          def generate_supersequence(words, perm):
              supersequence = ''
              last_positions = defaultdict(int)

              for idx in perm:
                  word = words[idx]
                  for char in word:
                      if last_positions[char] < len(supersequence):
                          pos = supersequence.find(char, last_positions[char])
                          if pos == -1:
                              supersequence += char
                              last_positions[char] = len(supersequence)
                          else:
                              last_positions[char] = pos + 1
                      else:
                          supersequence += char
                          last_positions[char] = len(supersequence)

              return supersequence

          # Find unique supersequences
          def find_unique_supersequences(words):
              unique_supersequences = set()
              for perm in generate_permutations(words):
                  superseq = generate_supersequence(words, perm)
                  unique_supersequences.add(superseq)
              return unique_supersequences

          # Calculate frequency array
          def calculate_frequency_array(s):
              freq = [0] * 26
              for char in s:
                  freq[ord(char) - ord('a')] += 1
              return freq

          # Find all unique supersequences
          unique_supersequences = find_unique_supersequences(words)

          # Convert each supersequence to its frequency array
          result = [calculate_frequency_array(scs) for scs in unique_supersequences]

          # Return only distinct frequency arrays
          return list(map(list, {tuple(freq) for freq in result}))
      ]
