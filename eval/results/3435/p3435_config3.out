@given(st.lists(st.text(min_size=1, max_size=5, alphabet=st.characters(min_codepoint=ord('a'), max_codepoint=ord('z'))), min_size=1, max_size=5))
def property_test_no_loss_of_information(words):
    # Check if every word in the input is a subsequence of every SCS
    scs_list = supersequences(words)
    for scs_freq in scs_list:
        scs = ''.join(chr(i + ord('a')) * freq for i, freq in enumerate(scs_freq))
        for word in words:
            it = iter(scs)
            assert all(char in it for char in word)
@given(st.lists(st.text(min_size=1, alphabet=st.characters(min_codepoint=ord('a'), max_codepoint=ord('z'))), min_size=2, max_size=4))
def property_test_minimal_length(words):
    # For all supersequences, check if their lengths are minimal by comparing with naive concatenation
    scs_list = supersequences(words)
    min_len_possible = len(set(''.join(words))) + sum(len(word) - len(set(word)) for word in words)
    for scs_freq in scs_list:
        length_of_scs = sum(scs_freq)
        assert length_of_scs <= min_len_possible
@given(st.lists(st.text(min_size=1, max_size=1, alphabet=st.characters(min_codepoint=ord('a'), max_codepoint=ord('z'))), min_size=2))
def property_test_single_characters(words):
    # Special test based on hypothetically using only one character words
    scs_list = supersequences(words)
    unique_chars = set(''.join(words))
    expected_length = len(unique_chars)
    for scs_freq in scs_list:
        length_of_scs = sum(scs_freq)
        assert length_of_scs == expected_length

