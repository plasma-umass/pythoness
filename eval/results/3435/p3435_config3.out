      [[Pythoness] Synthesized function: 
 

      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from collections import Counter
          from itertools import permutations
          import math

          def scs_length(x, y):
              m, n = len(x), len(y)
              dp = [[0] * (n + 1) for _ in range(m + 1)]
              for i in range(m + 1):
                  for j in range(n + 1):
                      if i == 0 or j == 0:
                          dp[i][j] = i + j
                      elif x[i - 1] == y[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = min(dp[i - 1][j], dp[i][j - 1]) + 1
              return dp[m][n]

          def find_scs(s):
              seq = s[0]
              for i in range(1, len(s)):
                  len_a, len_b = len(seq), len(s[i])
                  lcs_len = math.inf
                  common_seq = ""
                  for k in range(len_a):
                      for l in range(len_b):
                          inner_seq = s[i][l:]
                          if seq[k:] == inner_seq[:len_a - k]:
                              if len(inner_seq) < lcs_len:
                                  lcs_len = len(inner_seq)
                                  common_seq = inner_seq
                  seq += common_seq[len(seq) - len(common_seq):]
              return seq

          scs_strings = set()
          for perm in permutations(words):
              scs_strings.add(find_scs(perm))

          scs_strings = sorted(scs_strings, key=lambda x: (len(x), x))

          result = []
          for scs in scs_strings:
              freq = [0] * 26
              count = Counter(scs)
              for char, cnt in count.items():
                  freq[ord(char) - ord('a')] = cnt
              result.append(freq)

          return result
      ]
