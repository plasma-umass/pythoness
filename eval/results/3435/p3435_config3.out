      @given(st.lists(st.text(alphabet='abcdefghijklmnopqrstuvwxyz', min_size=1, max_size=10), min_size=1, max_size=5))
      def property_test_1(words):
          # Test that the length of each SCS is at least as long as the longest input word
          result = supersequences(words)
          longest_word_length = max(map(len, words))
          for freq_array in result:
              assert sum(freq_array) >= longest_word_length]
