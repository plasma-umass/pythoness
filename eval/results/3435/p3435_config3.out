@given(st.lists(st.text(min_size=1, max_size=5, alphabet='abcdefghijklmnopqrstuvwxyz'), min_size=1, max_size=5))
def property_test_1(words):
    result = supersequences(words)
    # Check that the result is a list of lists
    assert all(isinstance(freq, list) for freq in result)
    # Check that each sublist has 26 elements (one for each letter a-z)
    assert all(len(freq) == 26 for freq in result)
    # Check that each frequency list has only non-negative integers
    assert all(all(isinstance(n, int) and n >= 0 for n in freq) for freq in result)
@given(st.lists(st.text(min_size=1, max_size=5, alphabet='abcdefghijklmnopqrstuvwxyz'), min_size=1, max_size=5))
def property_test_2(words):
    result = supersequences(words)
    # Check that the frequency arrays correspond to actual supersequences
    for freq in result:
        # Recreate string from frequency
        recreated_supersequence = ''.join(chr(i + ord('a')) * n for i, n in enumerate(freq))
        # Each original word should be a subsequence of this recreated supersequence
        for word in words:
            iter_supersequence = iter(recreated_supersequence)
            assert all(char in iter_supersequence for char in word)
@given(st.lists(st.text(min_size=1, max_size=5, alphabet='abcdefghijklmnopqrstuvwxyz'), min_size=1, max_size=5))
def property_test_3(words):
    result = supersequences(words)
    # All generated supersequences from permissive input should have length greater than or equal to max input word length
    max_word_length = max(len(word) for word in words)
    for freq in result:
        supersequence_length = sum(freq)
        assert supersequence_length >= max_word_length
