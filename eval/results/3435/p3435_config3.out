      [[Pythoness] Synthesized function: 
 

      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays. 
          An SCS is a minimal-length string containing each string in the input words as a subsequence. 
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from collections import Counter
          from itertools import permutations

          def get_scs(x, y):
              # Find the Shortest Common Supersequence of two strings x and y
              m, n = len(x), len(y)
              dp = [[0] * (n + 1) for _ in range(m + 1)]
              for i in range(m + 1):
                  for j in range(n + 1):
                      if i == 0 or j == 0:
                          dp[i][j] = i + j
                      elif x[i - 1] == y[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = min(dp[i - 1][j] + 1, dp[i][j - 1] + 1)
              # Reconstruct the SCS itself
              i, j = m, n
              scs = []
              while i > 0 and j > 0:
                  if x[i - 1] == y[j - 1]:
                      scs.append(x[i - 1])
                      i -= 1
                      j -= 1
                  elif dp[i - 1][j] < dp[i][j - 1]:
                      scs.append(x[i - 1])
                      i -= 1
                  else:
                      scs.append(y[j - 1])
                      j -= 1
              while i > 0:
                  scs.append(x[i - 1])
                  i -= 1
              while j > 0:
                  scs.append(y[j - 1])
                  j -= 1
              return ''.join(reversed(scs))

          # Find all unique permuted orders of the words
          permuted_orders = set(permutations(words))

          scs_set = set()
          for order in permuted_orders:
              current_scs = order[0]
              for word in order[1:]:
                  current_scs = get_scs(current_scs, word)
              scs_set.add(current_scs)

          # Convert each SCS string to a frequency array
          freq_vectors = []
          for scs in scs_set:
              freq = [0] * 26
              count = Counter(scs)
              for char, cnt in count.items():
                  freq[ord(char) - ord('a')] = cnt
              freq_vectors.append(freq)

          return freq_vectors
      ]
