      [[Pythoness] Synthesized function: 
 

      def supersequences(words):
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other and returns their frequency arrays.
          An SCS is a minimal-length string containing each string in the input words as a subsequence.
          The result is a 2D array where each sub-array represents the frequency of each lowercase English letter in a distinct SCS.
          """
          from collections import defaultdict, deque

          def merge_sequences(seq1, seq2):
              """Merge two sequences into one shortest common supersequence."""
              m, n = len(seq1), len(seq2)
              dp = [[0] * (n + 1) for _ in range(m + 1)]

              for i in range(m + 1):
                  for j in range(n + 1):
                      if i == 0:
                          dp[i][j] = j
                      elif j == 0:
                          dp[i][j] = i
                      elif seq1[i - 1] == seq2[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + 1
                      else:
                          dp[i][j] = min(dp[i - 1][j], dp[i][j - 1]) + 1

              i, j = m, n
              scs = []
              while i > 0 and j > 0:
                  if seq1[i - 1] == seq2[j - 1]:
                      scs.append(seq1[i - 1])
                      i -= 1
                      j -= 1
                  elif dp[i - 1][j] < dp[i][j - 1]:
                      scs.append(seq1[i - 1])
                      i -= 1
                  else:
                      scs.append(seq2[j - 1])
                      j -= 1
              while i > 0:
                  scs.append(seq1[i - 1])
                  i -= 1
              while j > 0:
                  scs.append(seq2[j - 1])
                  j -= 1

              return ''.join(reversed(scs))

          def generate_all_scs(words):
              dq = deque(words)
              while len(dq) > 1:
                  seq1 = dq.popleft()
                  seq2 = dq.popleft()
                  merged = merge_sequences(seq1, seq2)
                  dq.append(merged)
              return dq[0]

          scs_result = generate_all_scs(words)
          freq_dict = defaultdict(int)
          for char in scs_result:
              freq_dict[char] += 1
          frequency_array = [0] * 26
          for char, count in freq_dict.items():
              frequency_array[ord(char) - ord('a')] = count
          return [frequency_array]

      ]
