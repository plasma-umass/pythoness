      def property_test_supersequences_length_is_minimal(words):
          scs_freqs = supersequences(words)
          all_supersequences = [''.join([chr(i + ord('a')) * freq for i, freq in enumerate(freqs)]) for freqs in scs_freqs]
          assert all(len(scs) == min(len(s) for s in all_supersequences) for scs in all_supersequences)]
