      [[Pythoness] Synthesized function: 
 

      def supersequences(words: List[str]) -> List[List[int]]:
          """
          Finds all shortest common supersequences (SCS) of an array of strings that are not permutations of each other
          and returns their frequency arrays. An SCS is a minimal-length string containing each string in the input words
          as a subsequence. The result is a 2D array where each sub-array represents the frequency of each lowercase
          English letter in a distinct SCS.
          """
          from itertools import permutations, combinations
          from collections import defaultdict, Counter
          from functools import lru_cache

          # Function to get the length of the shortest common supersequence
          @lru_cache(None)
          def scs_len(x, y):
              m, n = len(x), len(y)
              if m == 0: return n
              if n == 0: return m
              if x[-1] == y[-1]:
                  return 1 + scs_len(x[:-1], y[:-1])
              else:
                  return 1 + min(scs_len(x[:-1], y), scs_len(x, y[:-1]))

          # Find all possible shortest common supersequences for pairs of strings
          pair_scs = defaultdict(list)
          for x, y in combinations(words, 2):
              length = scs_len(x, y)
              for p in permutations(words):
                  current_scs = p[0]
                  for w in p[1:]:
                      current_scs = merge(current_scs, w)
                  if length == len(current_scs) and current_scs not in pair_scs[(x, y)]:
                      pair_scs[(x, y)].append(current_scs)

          def merge(x, y):
              # Merge two words to form their shortest common supersequence
              m, n = len(x), len(y)
              dp = [[None] * (n + 1) for _ in range(m + 1)]
              for i in range(m + 1):
                  for j in range(n + 1):
                      if i == 0:
                          dp[i][j] = y[:j]
                      elif j == 0:
                          dp[i][j] = x[:i]
                      elif x[i - 1] == y[j - 1]:
                          dp[i][j] = dp[i - 1][j - 1] + x[i - 1]
                      else:
                          dp[i][j] = min(dp[i - 1][j] + x[i - 1], dp[i][j - 1] + y[j - 1], key=len)
              return dp[m][n]

          # Find unique SCS and determine their frequencies
          all_scs = set()
          for scs_list in pair_scs.values():
              all_scs.update(scs_list)

          freqs = []
          for scs in all_scs:
              freq = Counter(scs)
              freq_array = [freq.get(chr(i), 0) for i in range(97, 123)]
              if freq_array not in freqs:
                  freqs.append(freq_array)

          return freqs

      ]
