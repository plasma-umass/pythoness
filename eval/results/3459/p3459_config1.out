                      break
                  x += dx
                  y += dy
              return length

          max_length = 0

          for i in range(len(grid)):
              for j in range(len(grid[0])):
                  if grid[i][j] == 1:
                      # Check diagonal down-right
                      length1 = check_diagonal(i, j, 1, 1) 
                      # Check diagonal down-left
                      length2 = check_diagonal(i, j, 1, -1)
                      max_length = max(max_length, length1, length2)

