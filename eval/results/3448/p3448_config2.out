      [[Pythoness] Synthesized function: 
 

      def countSubstrings(s: str) -> int:
          """
          Counts the substrings of a digit string divisible by their non-zero last digit.
          Given a string `s` of digits, this function returns how many of its substrings can be divided by their last non-zero digit.
          Constraints: 1 <= len(s) <= 10^5, s contains digits only.
          """
          n = len(s)
          count = 0

          for i in range(n):
              # Start a new substring ending at index i
              last_digit = int(s[i])
              if last_digit == 0:
                  continue
              num = 0
              # Traverse backwards to form all substrings ending with s[i]
              for j in range(i, -1, -1):
                  num = num * 10 + int(s[j])
                  # We need to reverse digits to check divisibility correctly
                  reversed_num = int(str(num)[::-1])
                  if reversed_num % last_digit == 0:
                      count += 1

          return count

      ]
