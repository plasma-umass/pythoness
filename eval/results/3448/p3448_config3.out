      def countSubstrings(s: str) -> int:
          """
          Counts the substrings of a digit string divisible by their non-zero last digit.
          Given a string `s` of digits, this function returns how many of its substrings 
          can be divided by their last non-zero digit.
          Constraints: 1 <= len(s) <= 10^5, s contains digits only.
          """
          count = 0
          n = len(s)

          for i in range(n):
              current_number = 0
              last_digit = int(s[i])

              if last_digit == 0:
                  continue

              for j in range(i, n):
                  current_number = current_number * 10 + int(s[j])

                  if current_number % last_digit == 0:
                      count += 1

          return count

      ]
