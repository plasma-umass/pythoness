      def countSubstrings(s: str) -> int:
          """
          Counts the substrings of a digit string divisible by their non-zero last digit.
          Given a string `s` of digits, this function returns how many of its substrings can be divided by their last non-zero digit.
          Constraints: 1 <= len(s) <= 10^5, s contains digits only.
          """
          count = 0
          n = len(s)

          # Iterate over every possible starting position for a substring
          for start in range(n):
              num = 0
              last_digit = None
              # Iterate over every possible ending position for any given starting position
              for end in range(start, n):
                  num = num * 10 + int(s[end])
                  if s[end] != '0':
                      last_digit = int(s[end])
                  # Check divisibility by the last non-zero digit
                  if last_digit and num % last_digit == 0:
                      count += 1

          return count

      ]
