      [[Pythoness] Synthesized function: 
       def distanceSum(m: int, n: int, k: int) -> int:
          """Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid. 
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7. 
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n."""
          MOD = 10**9 + 7
          # Precompute total number of grid cells and factorial values
          total_cells = m * n
          fact = [1] * (total_cells + 1)
          inv_fact = [1] * (total_cells + 1)

          # Compute all factorials % MOD
          for i in range(2, total_cells + 1):
              fact[i] = fact[i - 1] * i % MOD

          # Compute all inverse factorials % MOD using Fermat's little theorem
          def mod_exp(base, exp, modulus):
              result = 1
              while exp > 0:
                  if exp % 2 == 1:
                      result = (result * base) % modulus
                  base = (base * base) % modulus
                  exp //= 2
              return result

          inv_fact[total_cells] = mod_exp(fact[total_cells], MOD - 2, MOD)
          for i in range(total_cells - 1, 0, -1):
              inv_fact[i] = inv_fact[i + 1] * (i + 1) % MOD

          # Calculate the sum of Manhattan distances based on pairs
          def manhattan_sum(length):
              return length * (length - 1) // 2

          horizontal_sum = manhattan_sum(m) * n**2 % MOD
          vertical_sum = manhattan_sum(n) * m**2 % MOD
          total_sum = (horizontal_sum + vertical_sum) % MOD

          # Now calculate the combination of k pieces
          combinations = fact[total_cells] * inv_fact[k] % MOD * inv_fact[total_cells - k] % MOD

          # Result is total_sum times combinations % MOD 
          result = total_sum * combinations % MOD
          return result]
