       def distanceSum(m: int, n: int, k: int) -> int:
          """Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid.
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7.
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n."""
          MOD = 10**9 + 7
          total_cells = m * n

          def sum_of_consecutive(n):
              return n * (n + 1) // 2

          row_sum = (sum_of_consecutive(m - 1) * n * n) % MOD
          col_sum = (sum_of_consecutive(n - 1) * m * m) % MOD
          total_distance_sum = (row_sum + col_sum) % MOD

          # Python's factorial handling using a loop to prevent large computations
          def factorial_mod(x):
              result = 1
              for i in range(2, x + 1):
                  result = result * i % MOD
              return result

          # Function to compute nCr % MOD
          def comb(n, r):
              if n < r:
                  return 0
              if r == 0 or n == r:
                  return 1
              num = factorial_mod(n)
              denom = (factorial_mod(r) * factorial_mod(n - r)) % MOD
              return num * pow(denom, MOD - 2, MOD) % MOD

          combinations = comb(total_cells - 2, k - 2)
          result = (total_distance_sum * combinations) % MOD

          return result]
