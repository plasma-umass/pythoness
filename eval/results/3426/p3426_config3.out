       def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid.
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7.
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7

          def modularInverse(a, p):
              return pow(a, p - 2, p)

          def combination(n, k, MOD):
              if k > n:
                  return 0
              if k == 0 or k == n:
                  return 1
              num = 1
              denom = 1
              for i in range(k):
                  num = num * (n - i) % MOD
                  denom = denom * (i + 1) % MOD
              return num * modularInverse(denom, MOD) % MOD

          total_cells = m * n

          def sum_of_linear_distances(length):
              return (length * (length - 1) * (2 * length - 1) // 6) % MOD

          x_dist = sum_of_linear_distances(m) * n ** 2 % MOD
          y_dist = sum_of_linear_distances(n) * m ** 2 % MOD

          total_distance = (x_dist + y_dist) % MOD
          result = total_distance * combination(total_cells - 2, k - 2, MOD) % MOD

          return result
      ]
