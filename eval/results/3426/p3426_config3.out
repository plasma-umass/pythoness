      def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m 
       n grid. 
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7. 
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10 ** 9 + 7

          # Calculate the sum of coordinates from 0 to m-1 and 0 to n-1
          def coordinate_sum(x):
              return x * (x - 1) // 2

          # Total number of cells
          total_cells = m * n

          # Sum of x and y coordinates
          sum_x = (coordinate_sum(m) * n) % MOD
          sum_y = (coordinate_sum(n) * m) % MOD

          # Function to calculate C(n, k)
          def nCr(n, r):
              if r > n:
                  return 0
              if r == 0 or n == r:
                  return 1
              numerator = 1
              denominator = 1
              for i in range(r):
                  numerator = (numerator * (n - i)) % MOD
                  denominator = (denominator * (i + 1)) % MOD
              # Use modular inverse for division, Fermat's little theorem
              return (numerator * pow(denominator, MOD - 2, MOD)) % MOD

          total_ways = nCr(total_cells, k)

          # Calculate the contribution of each axis to the distance
          def calculate_contribution(sum_coordinate, length):
              return (2 * sum_coordinate * nCr(total_cells - length, k - 1)) % MOD

          result = (calculate_contribution(sum_x, m) + calculate_contribution(sum_y, n)) % MOD

          # Each pair is counted twice, divide by 2
          return (result * pow(2, MOD - 2, MOD)) % MOD

      ]
