      [[Pythoness] Synthesized function: 
 

      def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid. 
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7. 
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7

          def sum_of_first_n_numbers(n):
              return n * (n + 1) // 2

          def calculate_single_axis(size, k):
              # Calculate contribution for one axis (either row or column)
              full_sum = sum_of_first_n_numbers(size - 1)
              sum_distances = full_sum * (k // size)
              excess_pieces = k % size
              sum_distances += sum_of_first_n_numbers(excess_pieces - 1)
              correction = excess_pieces * (full_sum - sum_of_first_n_numbers(size - excess_pieces - 1))
              sum_distances += correction
              return sum_distances

          total_sum = 0
          total_sum += calculate_single_axis(m, k) * n  # Contribution for rows
          total_sum += calculate_single_axis(n, k) * m  # Contribution for columns
          total_sum %= MOD
          return total_sum

      ]
