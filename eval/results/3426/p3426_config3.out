              # Navigate through each valid start `i` for the combination of `j` pieces
              for i in range(min(max_dim, k)):
                  # Contribution at each position `i`
                  num_options_at_i = (k - 1 - i) * (i + 1) * fixed_dim
                  total += (num_options_at_i * (i + 1)) % MOD
                  total %= MOD
              return total

          # Calculate row contributions and column contributions separately
          total_row_contribution = sum_distances(m, n)
          total_col_contribution = sum_distances(n, m)
          # Total Manhattan Distance is a combination of the row and column contributions
          total_distance = (total_row_contribution + total_col_contribution) % MOD
    
          return total_distance
      ]
