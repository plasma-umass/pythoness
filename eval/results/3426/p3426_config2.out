       def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid. 
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7. 
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7
    
          def sum_of_arithmetic_sequence(n):
              return n * (n - 1) // 2

          def total_distance_along_line(line_length: int, pieces: int) -> int:
              if pieces > line_length:
                  pieces = line_length
              return sum_of_arithmetic_sequence(pieces) * (line_length - pieces + 1)

          def overall_distance(length: int, pieces: int) -> int:
              prefix_sum = 0
              current_distance = 0

              for i in range(1, pieces):
                  current_distance += i * length - prefix_sum
                  prefix_sum += i

              return current_distance

          total_cells = m * n
          if k == total_cells:
              return 0
    
          row_contribution = overall_distance(m, k)
          col_contribution = overall_distance(n, k)

          result = 2 * (row_contribution * n + col_contribution * m)

          return result % MOD
      ]
