      [[Pythoness] Synthesized function: 
       def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid.
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7.
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7

          def add(x, y):
              return (x + y) % MOD

          def sub(x, y):
              return (x - y + MOD) % MOD

          def mul(x, y):
              return x * y % MOD

          def comb(n, k):
              if k > n or k < 0:
                  return 0
              return mul(fact[n], mul(invfact[k], invfact[n - k]))

          def precompute_factorials(max_n):
              fact = [1] * (max_n + 1)
              invfact = [1] * (max_n + 1)
              for i in range(2, max_n + 1):
                  fact[i] = mul(fact[i - 1], i)
              invfact[max_n] = pow(fact[max_n], MOD - 2, MOD)
              for i in range(max_n - 1, 0, -1):
                  invfact[i] = mul(invfact[i + 1], i + 1)
              return fact, invfact

          fact, invfact = precompute_factorials(m * n)

          def manhattan_sum_length(l):
              # Sum of distances for a line of length l
              total = 0
              for x in range(l):
                  total = add(total, mul(x, mul(l - x - 1, comb(l - x - 2, k - 2))))
              return mul(total, comb(l, k))

          result = 0
          result = add(result, mul(manhattan_sum_length(m), n))
          result = add(result, mul(manhattan_sum_length(n), m))

          return result
      ]
