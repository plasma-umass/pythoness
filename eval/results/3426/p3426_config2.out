      [[Pythoness] Synthesized function: 
       def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid. 
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7. 
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7

          def sum_of_first_n_numbers(x):
              return x * (x + 1) // 2

          def compute_distance(sum_single_dim, length, count):
              total_distance = (2 * sum_single_dim * count * length - 
                                4 * sum_single_dim * (count * (count - 1) // 2) +
                                count * (count - 1) * (2 * count - 1) // 6)
              return total_distance % MOD

          # Calculate the sum of first m-1 and n-1 numbers
          sum_m_minus_1 = sum_of_first_n_numbers(m - 1)
          sum_n_minus_1 = sum_of_first_n_numbers(n - 1)

          # Total sum for 1D arrangement in x and y direction
          sum_x = compute_distance(sum_m_minus_1, n, k)
          sum_y = compute_distance(sum_n_minus_1, m, k)

          # Total Manhattan distance
          total_distance = (sum_x * n * (m - k) + sum_y * m * (n - k)) % MOD

          return total_distance
      ]
