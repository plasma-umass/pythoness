      def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid.
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7.
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7
    
          def sum_of_distances(length: int) -> int:
              # Calculate the sum of distances between all pairs on a linear line-length
              total = length * (length - 1) // 2
              return total

          # Sum for rows and columns
          total_row_distance = m * sum_of_distances(n) % MOD
          total_col_distance = n * sum_of_distances(m) % MOD
    
          total_distance = (total_row_distance + total_col_distance) % MOD

          # Calculate the final answer using combinatory logic
          total_pairs = k * (k - 1) // 2 % MOD
          result = total_distance * total_pairs % MOD

          return result

      ]
