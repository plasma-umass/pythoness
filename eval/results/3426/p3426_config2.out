      [[Pythoness] Synthesized function: 
       def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid.
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7.
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7
    
          def sum_of_first_n(n):
              return n * (n + 1) // 2

          def sum_of_first_n_squares(n):
              return n * (n + 1) * (2 * n + 1) // 6

          total_cells = m * n
          if k == 2:
              range_n = max(m, n)
              range_m = min(m, n)
              total_distance = 0
              # Calculate horizontal and vertical distances separately
              for size in range(1, range_n):
                  total_distance += sum_of_first_n(size) * (range_n - size) * (range_m ** 2)
                  total_distance %= MOD
              # Calculate grid-based sum
              sum_grid = sum_of_first_n(range_m - 1)
              total_distance *= sum_grid
              total_distance %= MOD
              return total_distance

          # General case
          inverse = pow(2, MOD-2, MOD)  # Fermat's Little Theorem

          def comb(n, k):
              if k > n:
                  return 0
              num = 1
              den = 1
              for i in range(k):
                  num = num * (n - i) % MOD
                  den = den * (i + 1) % MOD
              return num * pow(den, MOD-2, MOD) % MOD

          def compute_distance(total_cells, k):
              result = 0
              for d in range(total_cells // k):
                  horizontal = d * (total_cells - d)
                  result += comb(total_cells - d, k) * horizontal
                  result %= MOD
              return result * inverse % MOD

          return compute_distance(total_cells, k)
      ]
