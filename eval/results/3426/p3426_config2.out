      [[Pythoness] Synthesized function: 
 
      def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid. 
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7. 
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 1000000007

          # Helper to calculate sum of i*(k-i)*C(n-2, k-2) for i in range(n)
          def calculate_distance_sum(n):
              total = 0
              for i in range(n):
                  total += i * (n-i)
              return total 

          # Total ways to choose 2 pieces from k pieces
          num_pairs = (k * (k - 1)) // 2

          # Calculate horizontal and vertical contributions, then sum them
          x_distance = calculate_distance_sum(m)
          y_distance = calculate_distance_sum(n)

          # Total contribution from all such pairs
          total_distance = (num_pairs * (x_distance * n + y_distance * m)) % MOD

          return total_distance

      ]
