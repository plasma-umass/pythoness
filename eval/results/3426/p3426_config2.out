      def distanceSum(m: int, n: int, k: int) -> int:
          """
          Calculate the sum of Manhattan distances between all pairs of k identical pieces placed on an m × n grid.
          Return the result for all valid arrangements of the pieces, ensuring only one piece per cell, and the result modulo 10^9 + 7.
          The function adheres to constraints: 1 <= m, n <= 10^5, 2 <= m * n <= 10^5, 2 <= k <= m * n.
          """
          MOD = 10**9 + 7

          def total_contribution(size: int, k: int) -> int:
              prefix_sum = [0] * (size + 1)
              for i in range(1, size + 1):
                  prefix_sum[i] = prefix_sum[i - 1] + i - 1
              result = 0
              for i in range(1, size + 1):
                  left_count = i - 1
                  right_count = size - i
                  left_k = min(k - 1, left_count)
                  right_k = min(k - 1, right_count)
                  result += prefix_sum[left_count] - prefix_sum[left_count - left_k]
                  result += prefix_sum[right_count] - prefix_sum[right_count - right_k]
                  result %= MOD
              return result
    
          row_contribution = total_contribution(m, k)
          col_contribution = total_contribution(n, k)

          answer = (row_contribution * n + col_contribution * m) % MOD
    
          answer = (answer * (k * (k - 1) // 2 % MOD)) % MOD

          return answer

      ]
