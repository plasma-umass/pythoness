       def generateString(str1: str, str2: str) -> str:
          """
          Generate the lexicographically smallest string from str1 and str2 given specific matching conditions.
          For each index in str1, if str1[i] is 'T', the substring of length m starting at that index must match str2,
          otherwise it must not match. If generating such a string is not possible, return an empty string.
          """
          m = len(str2)
          n = len(str1)
          result = []
          i = 0
          while i < n:
              if str1[i] == 'T':
                  # Check if substring starting at i can match str2
                  if i + m <= n and str1[i:i + m] == 'T' * m:
                      result.append(str2)
                      i += m
                  else:
                      return ''
              else:
                  # For 'F', append the smallest lexicographical character excluding those from str2
                  candidates = [chr(c) for c in range(97, 123) if chr(c) not in str2]
                  result.append(candidates[0])
                  i += 1
          return ''.join(result)
      ]
