       def generateString(str1: str, str2: str) -> str:
          """
          Generate the lexicographically smallest string from str1 and str2 given specific matching conditions. For each index in str1, if str1[i] is 'T', the substring of length m starting at that index must match str2, otherwise, it must not match. If generating such a string is not possible, return an empty string.
          """
          m = len(str2)
          n = len(str1)
          result = []

          i = 0
          while i < n:
              if str1[i] == 'T':
                  # Check if there's enough space for str2
                  if i + m > n:
                      return ""
                  # Ensure the substring matches str2
                  if str1[i:i + m] != 'T' * m:
                      return ""
                  result.append(str2)
                  i += m
              else:
                  # Insert the smallest character that is not part of str2
                  j = 0
                  while str2[j] == 'a'[j % len('a')] and j < len(str2):
                      j += 1
                  if j == len(str2):
                      result.append('b')
                  else:
                      result.append('a')
                  i += 1

          return ''.join(result)]
