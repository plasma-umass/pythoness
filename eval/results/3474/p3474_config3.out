       def generateString(str1: str, str2: str) -> str:
          """
          Generate the lexicographically smallest string from str1 and str2 given specific matching conditions. For each index in str1, if str1[i] is 'T', the substring of length m starting at that index must match str2, otherwise, it must not match. If generating such a string is not possible, return an empty string.
          """
          m = len(str2)
          n = len(str1)
          result = []

          i = 0
          while i < n:
              if str1[i] == 'T':
                  # Check if we can take str2 as substring starting from i
                  if i + m > n:
                      return ""  # Not enough space for str2
                  if str2 != ''.join(result[i:i+m]):
                      result.extend(str2)
                      i += m
                  else:
                      return ""  # Substring does not match where it should
              else:
                  # Add smallest character that is not the start of str2 to keep the result lexicographically smallest
                  result.append('a' if str2[0] != 'a' else 'b')
                  i += 1

          return ''.join(result)]
