      def generateString(str1: str, str2: str) -> str:
          """
          Generate the lexicographically smallest string from str1 and str2 given specific matching conditions. For each index in str1, if str1[i] is 'T', the substring of length m starting at that index must match str2, otherwise, it must not match. If generating such a string is not possible, return an empty string.
          """
          m = len(str2)
          n = len(str1)
          result = []
          i = 0
    
          while i < n:
              if str1[i] == 'T':
                  # Ensure that there are enough characters remaining in str1 from i
                  if i + m > n:
                      return ""
                  # Check the substring condition
                  if str1[i:i+m] == 'T' * m:
                      # Append str2 because it should match
                      result.append(str2)
                      i += m
                  else:
                      return ""
              else:
                  # Append the smallest character possible and check not to match str2
                  result.append('a')
                  # If appending 'a' makes it match str2, change to the next character
                  if ''.join(result[-m:]) == str2:
                      result[-1] = 'b'
                  i += 1
    
          return ''.join(result)

      ]
