       st.integers(min_value=1, max_value=100))
def property_test_2(nums, single_target):
    """
    Test that a single target with the greatest common divisor (GCD)
    being 1 requires a non-zero operation count if not present in nums.
    """
    from math import gcd
    if not any(n % single_target == 0 for n in nums):
        gcd_all = nums[0]
        for n in nums[1:]:
