       def minimumIncrements(nums, target):
          """Calculates the minimum number of operations needed to ensure each element in the target array has at least one multiple in the nums array. In each operation, any element in nums can be incremented by 1. The function ensures compliance with constraints on array lengths and element values."""
          from math import gcd
          nums.sort()
    
          def lcm(x, y):
              return x * y // gcd(x, y)

          lcm_all = 1
          for number in nums:
              lcm_all = lcm(lcm_all, number)
              if lcm_all > 2 * max(target):
                  break
    
          min_operations = 0

          for t in target:
              minimum_difference = float('inf')
              for num in nums:
                  if t % num == 0:
                      minimum_difference = 0
                      break
                  else:
                      difference = ((num * (t // num + 1)) - t) % t
                      minimum_difference = min(minimum_difference, difference)
              min_operations += minimum_difference

          return min_operations
      ]
