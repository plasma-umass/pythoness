              min_increments_for_t = float('inf')

              for n in nums:
                  mod = n % t
                  if mod == 0:
                      min_increments_for_t = 0
                      break
                  else:
                      increments_needed = t - mod
                      min_increments_for_t = min(min_increments_for_t, increments_needed)

              total_increments += min_increments_for_t

          return total_increments
      ]
