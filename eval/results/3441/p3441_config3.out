      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          n = len(caption)
          if n == 0:
              return ""

          # Function to calculate minimum cost to make a good caption
          def min_cost_to_good(start_char):
              current = start_char
              result = []
              count = 0
              for ch in caption:
                  if ch == current:
                      count += 1
                  else:
                      while count < 3:  # Add needed characters
                          result.append(current)
                          count += 1
                      count = 1
                      current = ch
                      result.append(current)
                  if count == 3:  # Switch character if we reach 3
                      while start_char == current or count < 3:
                          result.append(current)
                          count += 1
                      current = chr(97 + (ord(current) - 96) % 26)
                      count = 0
              while count < 3:
                  result.append(current)
                  count += 1
              return ''.join(result)

          # Try conversions
          try_result = min_cost_to_good(caption[0])
          if len(try_result) > n:
              return try_result[:n]
          return try_result

      ]
