      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          n = len(caption)
          if n == 0:
              return ""
    
          from collections import Counter

          # Result array to store the final characters
          result = []
    
          # A temporary list to track consecutive characters
          temp = [caption[0]]
    
          # Traverse the input caption
          for i in range(1, n):
              if caption[i] == temp[-1]:
                  temp.append(caption[i])
              else:
                  # If the length of temp is at least 3, it's already a good group
                  if len(temp) < 3:
                      # Otherwise, we need to adjust the sequence
                      min_char = min(temp[0], caption[i])
                      result.extend([min_char] * 3)
                  else:
                      result.extend(temp)
            
                  # Reset temp for the new character
                  temp = [caption[i]]
          # Handle the last group if there are leftovers
          if len(temp) < 3:
              result.extend([temp[0]] * 3)
          else:
              result.extend(temp)

          # Ensure result is not longer than original string
          if len(result) <= n:
              return ''.join(result)
          else:
              return ''

      ]
