      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          if len(caption) == 0:
              return ""
    
          # Find minimum cost and lexicographical changes
          def helper_change_to_good(s):
              n = len(s)
              i = 0
              chars = []
              while i < n:
                  cnt = 1
                  while i + cnt < n and s[i] == s[i + cnt]:
                      cnt += 1
                  if cnt >= 3:
                      chars.append((s[i], cnt))
                  else:
                      need = 3 - cnt
                      cost = [(s[i], count_adjacent(cost1=s[i], cost2=s[i+j])) for j in range(-need, need+1) if 0 <= i+j < n]
                      best_char, best_cost = min(cost, key=lambda x: (x[1], x[0]))
                      chars.append((best_char, 3))
                  i += cnt
              return ''.join(c * num for c, num in chars)
    
          # Calculate adjacency cost
          def count_adjacent(cost1, cost2):
              alph = 'abcdefghijklmnopqrstuvwxyz'
              return abs(alph.index(cost1) - alph.index(cost2))

          return helper_change_to_good(caption)

      ]
