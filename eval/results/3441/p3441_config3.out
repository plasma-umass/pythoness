      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          # We will iterate over the caption and maintain a list of tuples (char, count)
          # that records the character and its run-length in the input caption.

          if not caption:
              return ""

          n = len(caption)

          if n < 3:
              return "" # Impossible to form a good caption with less than 3 characters

          result = []
          i = 0

          while i < n:
              j = i
              while j < n and caption[j] == caption[i]:
                  j += 1
              length = j - i

              if length >= 3:
                  # We have enough characters, add them to the result
                  result.append(caption[i] * length)
              else:
                  # Find the best character group to turn these into a good set
                  # Try to meld backwards if possible
                  if result and (ord(result[-1][0]) - ord(caption[i]) in [-1, 1]):
                      # We can adjust the last group
                      adjacent_char = chr(ord(result[-1][0]))
                      result[-1] = result[-1] + (adjacent_char * (3 - len(result[-1]) % 3))
                  else:
                      # Otherwise, pick the current character group and adjust
                      adjacent_char = chr(ord(caption[i]) + 1) if i == 0 or caption[i] == 'a' else chr(ord(caption[i]) - 1)
                      result.append(adjacent_char * 3)

              i = j

          return ''.join(result)

      ]
