      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
    
          if len(caption) < 3:
              # If length is less than 3, cannot form a 'good caption'
              return ''

          # List to keep the resulting characters
          result = []
          n = len(caption)
          i = 0
          while i < n:
              # Start a block of at least 3 identical characters
              start = i
              while i < n and caption[i] == caption[start]:
                  i += 1

              # Length of the current block
              length = i - start

              # Calculate how many more characters needed to make it a 'good block'
              if length >= 3:
                  result.extend([caption[start]] * length)
              else:
                  # Increase the block to the nearest bigger block satisfying the good caption condition
                  remaining = 3 - length
                  # Prefer the character to change to be the smallest possible?
                  ch = caption[start]

                  # Check if we can simply extend using same character by shifting
                  if i < n and length + 1 >= 3:
                      result.extend([ch] * 3)
                      overlap = 2 - length
                      i -= overlap
                  else:
                      prev_char = chr(max(ord('a'), ord(ch) - remaining))
                      result.extend([prev_char] * 3)

          # Join the list into a resultant string
          return ''.join(result)

      ]
