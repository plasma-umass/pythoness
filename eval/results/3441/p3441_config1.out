def minCostGoodCaption(caption: str) -> str:
    """
    Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

    Constraints:
    - 1 <= caption.length <= 5 * 10^4
    - The string consists only of lowercase English letters.
    """

    n = len(caption)
    if n < 3:
        return ""

    # Convert to list to allow mutation
    caption = list(caption)

    # Pointer for the new string
    i = 0
    
    def fill_same_char(c, length):
        # Try to fill with `length` same characters `c`
        nonlocal i
        for _ in range(length):
            caption[i] = c
            i += 1

    while i < n:
        start = i
        char = caption[start]
        count = 0
        while i < n and caption[i] == char:
            i += 1
            count += 1

        if count < 3:  # This segment is not good
            if start - 1 >= 0:  # Try to use the previous character if possible
                prev_char = caption[start - 1]
                if prev_char < char or i >= n:
                    c = prev_char
                else:
                    c = chr(ord(prev_char) + (prev_char < 'z'))
            else:  # Or, the next character
                c = chr(ord(char) + (char < 'z'))

            i = start
            fill_same_char(c, 3)
        else:
            i = start
            fill_same_char(char, count)
    
    return ''.join(caption)



