              current_char = caption[i]
              count = 1
              # Count consecutive characters
              while i + 1 < n and caption[i + 1] == current_char:
                  i += 1
                  count += 1
        
              # Add at least 3 of the same character
              if count >= 3:
                  result.extend([current_char] * count)
              else:
                  if current_char == 'a':
                      char_to_use = 'a'
                  elif current_char == 'z':
                      char_to_use = 'z'
                  else:
                      prev_char = chr(ord(current_char) - 1)
                      next_char = chr(ord(current_char) + 1)
                      if prev_char + prev_char + prev_char < next_char + next_char + next_char:
                          char_to_use = prev_char
                      else:
                          char_to_use = next_char
                  result.extend([char_to_use] * 3)
        
              i += 1
          return ''.join(result)
