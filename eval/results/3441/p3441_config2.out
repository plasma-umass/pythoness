      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          n = len(caption)
          if n == 0:
              return ''

          result = []
          i = 0

          while i < n:
              # Count frequency of the current character
              start = i
              while i < n and caption[i] == caption[start]:
                  i += 1

              freq = i - start
              char = caption[start]

              # If freq is already 3 or more, no need to change
              if freq >= 3:
                  result.append(char * freq)
              else:
                  # Boundary checks for character to decide where to adjust
                  prev_char = result[-1][-1] if result else 'a'
                  next_char = caption[i] if i < n else 'z'

                  # Calculate minimal adjustment cost, either up or down
                  # Try to form triple with this char, or adjust
                  down_char = chr(max(ord('a'), ord(char) - 1))
                  up_char = chr(min(ord('z'), ord(char) + 1))

                  # Try to resolve by adjusting frequency to meet the need
                  if down_char >= prev_char:
                      result.append(down_char * 3)
                  elif up_char <= next_char:
                      result.append(up_char * 3)
                  else:
                      result.append(char * 3)

          return ''.join(result)

      ]
