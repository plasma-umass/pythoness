      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          n = len(caption)
          if n == 0:
              return ''

          result = []
          i = 0
    
          while i < n:
              start = i
              while i < n - 1 and caption[i] == caption[i + 1]:
                  i += 1
              length = i - start + 1

              # If the current segment is already a 'good segment'
              if length >= 3:
                  result.append(caption[start:i+1])
              else:
                  # Find the character to which we can change current segment
                  # to make it good (length at least 3)
                  left_change = right_change = caption[start]

                  # Attempt to change to left adjacent character
                  if ord(caption[start]) > ord('a'):
                      left_change = chr(ord(caption[start]) - 1)

                  # Attempt to change to right adjacent character
                  if ord(caption[start]) < ord('z'):
                      right_change = chr(ord(caption[start]) + 1)

                  # Determine which change gives the lexicographically smaller result
                  if left_change * 3 < right_change * 3:
                      result.append(left_change * 3)
                  else:
                      result.append(right_change * 3)

              i += 1
    
          return ''.join(result)
      ]
