       def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          if not caption:
              return ''

          n = len(caption)
          result = []
          i = 0

          while i < n:
              start = i
              # Find length of current block of same characters
              while i + 1 < n and caption[i] == caption[i + 1]:
                  i += 1

              length = i - start + 1
              char = caption[start]

              # If the block is less than 3, adjust it
              while length < 3:
                  if start > 0 and char > 'a':
                      # Try decrementing current char if possible
                      char = chr(ord(char) - 1)
                      length += 1
                  elif char < 'z':
                      # Else, try incrementing current char if possible
                      char = chr(ord(char) + 1)
                      length += 1
                  else:
                      break

              # Append the adjusted block
              result.extend([char] * max(length, 3))
              i += 1

          # Remove any excess characters beyond the current run after adjustment
          res_length = len(result)
          i = 0
          final_result = []

          while i < res_length:
              start = i
              char = result[i]

              while i + 1 < res_length and result[i + 1] == char:
                  i += 1

              length = i - start + 1
              final_result.extend([char] * min(length, 3))
              i += 1

          return ''.join(final_result)
      ]
