      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
    
          n = len(caption)
          if n == 0:
              return ""

          result = []
          i = 0

          while i < n:
              count = 1
              while i + 1 < n and caption[i] == caption[i + 1]:
                  i += 1
                  count += 1
        
              if count >= 3:
                  result.extend([caption[i]] * count)
              else:
                  # Find the best option to make this portion a good segment
                  current_char = caption[i]

                  # Check transformation to (current_char - 1) which is one character before current_char
                  cost1, forming1 = 0, []
                  for j in range(count):
                      forming1.append(chr(max(ord('a'), ord(current_char) - 1)))
                      cost1 += abs(ord(current_char) - ord(forming1[-1]))
            
                  # Check transformation to (current_char + 1) which is one character after current_char
                  cost2, forming2 = 0, []
                  for j in range(count):
                      forming2.append(chr(min(ord('z'), ord(current_char) + 1)))
                      cost2 += abs(ord(current_char) - ord(forming2[-1]))

                  # Choose the lexicographically smallest option with minimum transformation cost
                  if cost1 < cost2 or (cost1 == cost2 and forming1 < forming2):
                      result.extend(forming1)
                  else:
                      result.extend(forming2)

              i += 1

          return ''.join(result)
      ]
