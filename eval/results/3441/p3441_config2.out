       def minCostGoodCaption(caption: str) -> str:
          """Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          n = len(caption)
          if n == 0:
              return ""

          # Initialize an empty list for the result which will store the characters
          result = []

          # Process each character in the caption
          i = 0
          while i < n:
              current_char = caption[i]
              start = i

              # Find the length of the current segment of the same character
              while i < n and caption[i] == current_char:
                  i += 1

              length = i - start

              # If length is already >= 3, append those characters directly
              if length >= 3:
                  result.extend([current_char] * length)
              else:
                  # We need at least 3 of some character, we select the best option
                  if start > 0 and ord(current_char) > ord('a'):
                      prev_char = chr(ord(current_char) - 1)
                  else:
                      prev_char = current_char

                  if i < n and ord(current_char) < ord('z'):
                      next_char = chr(ord(current_char) + 1)
                  else:
                      next_char = current_char

                  # Determine the costs of changing to adjacent alphabets
                  if prev_char != current_char:
                      cost_prev = abs(ord(current_char) - ord(prev_char))
                  else:
                      cost_prev = float('inf')

                  if next_char != current_char:
                      cost_next = abs(ord(current_char) - ord(next_char))
                  else:
                      cost_next = float('inf')

                  # Decide lower lexicographically between prev_char and next_char
                  if cost_prev < cost_next or (cost_prev == cost_next and prev_char < next_char):
                      chosen_char = prev_char
                  else:
                      chosen_char = next_char

                  result.extend([chosen_char] * 3)

          return "".join(result)
      ]
