      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
    
          n = len(caption)
          if n == 0:
              return ""

          result = []
          i = 0

          while i < n:
              j = i
              # Find the length of the current block of similar characters
              while j < n and caption[j] == caption[i]:
                  j += 1

              block_len = j - i

              if block_len >= 3:
                  # If the block is already a 'good' part
                  result.extend([caption[i]] * block_len)
              else:
                  if j < n:
                      # We have the option to merge with the next block
                      next_char = caption[j]
                      # Create the needed number of current or next characters
                      if ord(next_char) < ord(caption[i]):
                          result.extend([next_char] * 3)
                      else:
                          result.extend([caption[i]] * 3)
                  else:
                      # End of the string, just make a 'good' block of current
                      result.extend([caption[i]] * 3)

              i = j

          return ''.join(result)
      ]
