      def minCostGoodCaption(caption: str) -> str:
          """
          Convert a given string caption into a 'good caption' where each character appears in groups of at least 3 consecutive occurrences. Utilize operations to change any character to its adjacent in the alphabet, aiming for the minimum number of changes. Return the lexicographically smallest possible good caption or an empty string if conversion is impossible.

          Constraints:
          - 1 <= caption.length <= 5 * 10^4
          - The string consists only of lowercase English letters.
          """
          n = len(caption)
          if n == 0:
              return ''

          result = []
          i = 0
    
          while i < n:
              # Count frequency of the current character
              start = i
              while i < n and caption[i] == caption[start]:
                  i += 1

              freq = i - start
              char = caption[start]

              # If freq is already 3 or more, no need to change
              if freq >= 3:
                  result.append(char * freq)
              else:
                  # Find the best adjustment
                  # If this is the last or first possibility, adjust at boundaries
                  if start == 0:
                      # If start of string, can only increase to match 3
                      candidate = chr(ord(char) + 1)
                      nearest_possible = min(char * 3, candidate * (3 - freq) + char * freq)
                  elif i == n:
                      # If end of string, can only decrease to match 3
                      candidate = chr(ord(char) - 1)
                      nearest_possible = min(char * 3, candidate * (3 - freq) + char * freq)
                  else:
                      # Check adjustment options
                      prev_char = caption[start - 1]
                      next_char = caption[i] if i < n else '{'  # Beyond 'z'

                      if ord(prev_char) >= ord(next_char):
                          nearest_possible = min(char * 3, next_char + char * (3 - 1))
                      else:
                          nearest_possible = min(char * 3, prev_char + char * (3 - 1))

                  result.append(nearest_possible)
    
          return ''.join(result)

      ]
