              freq = i - start
              char = caption[start]

              # If freq is already 3 or more, no need to change
              if freq >= 3:
                  result.append(char * freq)
              else:
                  # Adjust to nearest good caption by examining neighbors
                  if start > 0:
                      prev_char = result[-1][-1]
                  else:
                      prev_char = 'a'

                  next_char_index = i
                  while next_char_index < n and caption[next_char_index] == caption[i - 1]:
                      next_char_index += 1

                  if next_char_index < n:
                      next_char = caption[next_char_index]
                  else:
                      next_char = 'z'

                  change_down = char
                  change_up = char

                  while change_down >= prev_char and freq < 3:
                      change_down = chr(ord(change_down) - 1)
                      freq += 1

                  while change_up <= next_char and freq < 3:
                      change_up = chr(ord(change_up) + 1)
                      freq += 1

                  # Determine which adjustment leads to a smaller lexicographical result
                  if change_down < change_up:
                      result.append(change_down * 3)
                  else:
                      result.append(change_up * 3)

          return ''.join(result)

      ]
