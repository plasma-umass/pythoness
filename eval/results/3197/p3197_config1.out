       def minimumSum(grid: List[List[int]]) -> int:
          """
          You are given a 2D binary array grid. You need to find 3 non-overlapping rectangles having non-zero areas with horizontal and vertical sides such that all the 1's in grid lie inside these rectangles.
          Return the minimum possible sum of the area of these rectangles.
          Note that the rectangles are allowed to touch.

          Constraints:

          1 <= grid.length, grid[i].length <= 30
          grid[i][j] is either 0 or 1.
          The input is generated such that there are at least three 1's in grid.
          """
          def count_ones(x1, y1, x2, y2):
              return sum(grid[i][j] for i in range(x1, x2 + 1) for j in range(y1, y2 + 1) if grid[i][j] == 1)

          rows = len(grid)
          cols = len(grid[0])

          ones_indices = [(i, j) for i in range(rows) for j in range(cols) if grid[i][j] == 1]

          min_area_sum = float('inf')

          for i in range(len(ones_indices)):
              for j in range(i + 1, len(ones_indices)):
                  for k in range(j + 1, len(ones_indices)):
                      x1, y1 = ones_indices[i]
                      x2, y2 = ones_indices[j]
                      x3, y3 = ones_indices[k]

                      # Determine the rectangles by calculating boundaries
                      x_min1, x_max1 = min(x1, x2), max(x1, x2)
                      y_min1, y_max1 = min(y1, y2), max(y1, y2)

                      x_min2, x_max2 = min(x2, x3), max(x2, x3)
                      y_min2, y_max2 = min(y2, y3), max(y2, y3)

                      x_min3, x_max3 = min(x1, x3), max(x1, x3)
                      y_min3, y_max3 = min(y1, y3), max(y1, y3)

                      rect1_area = (x_max1 - x_min1 + 1) * (y_max1 - y_min1 + 1)
                      rect2_area = (x_max2 - x_min2 + 1) * (y_max2 - y_min2 + 1)
                      rect3_area = (x_max3 - x_min3 + 1) * (y_max3 - y_min3 + 1)

                      # Check that the rectangles together cover all 1s and have non-zero area
                      if count_ones(x_min1, y_min1, x_max1, y_max1) + count_ones(x_min2, y_min2, x_max2, y_max2) + count_ones(x_min3, y_min3, x_max3, y_max3) == len(ones_indices):
                          total_area = rect1_area + rect2_area + rect3_area
                          min_area_sum = min(min_area_sum, total_area)

          return min_area_sum
      ]
