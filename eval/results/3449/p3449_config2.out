       def maxScore(points: List[int], m: int) -> int:
          """
          Calculate the maximum possible minimum value in an array gameScore, after making at most m moves within
          a bounds-constrained index system starting from before the first index. In each move, the index can
          increase or decrease by 1, and the corresponding points are added to gameScore at that index.
          """
          n = len(points)
          if n == 0:
              return 0

          answer = 0
          for left_taken in range(min(m, n) + 1):
              right_taken = m - left_taken
              total_scores = []

              # Take from the left
              total_scores.extend(points[:left_taken])
              # Take from the right
              if right_taken > 0:
                  total_scores.extend(points[max(0, n - right_taken):])
              total_scores.sort()

              # Minimum value that can be achieved
              if total_scores:
                  answer = max(answer, total_scores[0])

          return answer]
