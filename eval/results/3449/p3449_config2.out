      def maxScore(points: List[int], m: int) -> int:
          """
          Calculate the maximum possible minimum value in an array gameScore, after making at most m moves within 
          a bounds-constrained index system starting from before the first index. In each move, the index can 
          increase or decrease by 1, and the corresponding points are added to gameScore at that index.
          """
          n = len(points)

          # Check edge case when m is larger than the available indices
          if m >= n:
              return str(sum(points))

          # Initialize an array to store the minimum points after using k moves
          # Initialize with -1, which denotes an impossible state, except the starting point which is 0
          dp = [-1] * (m + 1)
          dp[0] = 0

          # Iterate through each possible move count
          for step in range(m + 1):
              for i in range(n):  # iterating over available points
                  if i > step:  # More moves than needed to reach this index
                      break
                  # Calculate the effective position
                  effective_index = step - i
                  if effective_index <= m and dp[i] != -1:
                      current_max = dp[i] + points[i]
                      if dp[effective_index] == -1 or current_max < dp[effective_index]:
                          dp[effective_index] = current_max

          # The valid dp values are only from the point we actually can forward from
          min_max_score = min(filter(lambda x: x != -1, dp))

          return str(min_max_score)

      ]
