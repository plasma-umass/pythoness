      def maxScore(points: List[int], m: int) -> int:
          """
          Calculate the maximum possible minimum value in an array gameScore, after making at most m moves within 
          a bounds-constrained index system starting from before the first index. In each move, the index can 
          increase or decrease by 1, and the corresponding points are added to gameScore at that index.
          """
          n = len(points)
    
          if n == 0:
              return 0

          # If allowed moves are greater than or equal twice the length of points, we can collect all points
          if m >= 2 * n - 2:
              return min(points)

          def calculate_min_score(left_moves, right_moves):
              # When moving left_moves to the left and right_moves to the right
              score_subset = points[:left_moves] + points[-right_moves:]
              return min(score_subset)

          max_min_score = 0
    
          # Try all combinations of left and right moves
          for left_moves in range(min(n, m+1)):
              right_moves = min(n, m - left_moves)
              if left_moves + right_moves <= m:
                  current_score = calculate_min_score(left_moves, right_moves)
                  max_min_score = max(max_min_score, current_score)

          return max_min_score
      ]
