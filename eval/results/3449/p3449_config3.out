       def maxScore(points: List[int], m: int) -> int:
          """
          Calculate the maximum possible minimum value in an array gameScore, after making at most m moves within 
          a bounds-constrained index system starting from before the first index. In each move, the index can 
          increase or decrease by 1, and the corresponding points are added to gameScore at that index.
          """
          from typing import List
          import sys

          n = len(points)

          def canAchieve(min_value: int) -> bool:
              max_reachable = [-sys.maxsize] * n
              if points[0] >= min_value:
                  max_reachable[0] = 0
              for i in range(1, n):
                  if points[i] >= min_value:
                      max_reachable[i] = max_reachable[i-1] + 1 if max_reachable[i-1] >= 0 else -sys.maxsize
                  if i-1 >= 0 and max_reachable[i-1] + 1 <= m:
                      max_reachable[i] = max(max_reachable[i], max_reachable[i-1] + 1)
                  if i-m-1 >= 0 and max_reachable[i-m-1] >= 0:
                      max_reachable[i] = max(max_reachable[i], i)

              return max_reachable[n-1] >= n-1

          left, right = 0, max(points)
          while left < right:
              mid = (left + right + 1) // 2
              if canAchieve(mid):
                  left = mid
              else:
                  right = mid - 1

          return left
      ]
