@given(st.lists(st.integers(min_value=0, max_value=100), min_size=1, max_size=100), st.integers(min_value=1, max_value=200))
def property_test_1(points, m):
    # Test that maxScore is at least 0 and at most the sum of points
    result = maxScore(points, m)
    assert 0 <= result <= sum(points)
@given(st.lists(st.integers(min_value=0, max_value=100), min_size=1, max_size=100), st.integers(min_value=1, max_value=200))
def property_test_2(points, m):
    # Test that maxScore of taking only the first element is at least points[0] if m > 0
    result = maxScore(points, m)
    if m > 0:
        assert result >= points[0]
@given(st.lists(st.integers(min_value=0, max_value=100), min_size=1, max_size=100), st.integers(min_value=1, max_value=200))
def property_test_3(points, m):
    # Property: maxScore with m moves should not exceed max score with m+1 moves
    if m < 200:
        result_m = maxScore(points, m)
        result_m_plus_1 = maxScore(points, m + 1)
        assert result_m <= result_m_plus_1
@given(st.lists(st.integers(min_value=0, max_value=100), min_size=1, max_size=100))
def property_test_4(points):
    # When m is zero, the result should be 0, as we cannot make any moves
    result = maxScore(points, 0)
    assert result == 0
@given(st.integers(min_value=0, max_value=100), st.integers(min_value=1, max_value=200))
def property_test_5(single_point, m):
    # If list consists of only one element, result should be either 0 or the element itself
    result = maxScore([single_point], m)
    assert result in [0, single_point]

