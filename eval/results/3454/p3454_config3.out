      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.

          The function should pass the following tests:
              separateSquares(squares = [[0,0,1],[2,2,1]]) == 1.00000
              separateSquares(squares = [[0,0,2],[1,1,1]]) == 1.00000
          """
          from typing import List

          # Collect all unique y-coordinates (both start and end of squares)
          y_coords = set()
          for x, y, l in squares:
              y_coords.add(y)
              y_coords.add(y + l)

          # Sort the y-coordinates
          y_coords = sorted(y_coords)

          # Use binary search over possible y-coordinates
          low, high = 0, len(y_coords) - 1
          total_area = sum(l * l for _, _, l in squares)

          def area_below(y_line) -> int:
              """Calculate total area below the given y_line."""
              covered_intervals = []
              for x, y, l in squares:
                  if y < y_line:
                      covered_intervals.append((x, min(y + l, y_line)))

              covered_intervals.sort()
              total_covered = 0
              current_x_end = -1

              for start_x, end_y in covered_intervals:
                  if current_x_end < start_x:
                      total_covered += end_y * (end_y - start_x)
                      current_x_end = end_y
                  else:
                      if end_y > current_x_end:
                          total_covered += end_y * (end_y - current_x_end)
                          current_x_end = end_y

              return total_covered

          while low < high:
              mid = (low + high) // 2
              if area_below(y_coords[mid]) * 2 >= total_area:
                  high = mid
              else:
                  low = mid + 1

          return float(y_coords[low])

      ]
