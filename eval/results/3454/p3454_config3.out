      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """

          from sortedcontainers import SortedList

          events = []
          for x, y, l in squares:
              events.append((y, x, x + l, 1))
              events.append((y + l, x, x + l, -1))

          events.sort()
          active_intervals = SortedList()
          total_area = 0
          area_at_curr_y = 0
          prev_y = events[0][0]

          for curr_y, x1, x2, typ in events:
              # Area calculation between prev_y and curr_y
              area_at_curr_y = 0
              last_x = -1
              for start_x, end_x in active_intervals:
                  last_x = max(last_x, start_x)
                  area_at_curr_y += max(0, end_x - last_x)
                  last_x = max(last_x, end_x)

              total_area += area_at_curr_y * (curr_y - prev_y)

              if typ == 1:  # Adding a square
                  active_intervals.add((x1, x2))
              else:  # Removing a square
                  active_intervals.remove((x1, x2))

              prev_y = curr_y

          # Binary search for the y-coordinate
          lo, hi = min(event[0] for event in events), max(event[0] for event in events)
          target_area = total_area / 2

          def compute_area_up_to(y):
              area = 0
              last_y = 0
              area_at_curr_y = 0
              active_intervals.clear()

              for curr_y, x1, x2, typ in events:
                  if curr_y > y:
                      break
                  area_at_curr_y = 0
                  last_x = -1
                  for start_x, end_x in active_intervals:
                      last_x = max(last_x, start_x)
                      area_at_curr_y += max(0, end_x - last_x)
                      last_x = max(last_x, end_x)

                  area += area_at_curr_y * (curr_y - last_y)
                  if typ == 1:
                      active_intervals.add((x1, x2))
                  else:
                      active_intervals.remove((x1, x2))
                  last_y = curr_y

              return area

          while hi - lo > 1e-5:
              mid = (lo + hi) / 2
              if compute_area_up_to(mid) < target_area:
                  lo = mid
              else:
                  hi = mid

          return lo

      ]
