      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.

          The function should pass the following tests:
              separateSquares(squares = [[0,0,1],[2,2,1]]) == 1.00000
              separateSquares(squares = [[0,0,2],[1,1,1]]) == 1.00000
          """
          from typing import List

          def calculate_area(y_line: float) -> float:
              """Calculate the area covered by squares below the y = y_line."""
              events = []
              for x, y, l in squares:
                  if y < y_line:
                      # Add events only if part of the square is below y_line
                      events.append((x, max(y, y_line - l), min(y + l, y_line), 1))
                      events.append((x + l, max(y, y_line - l), min(y + l, y_line), -1))

              events.sort()
              last_x = None
              total_area = 0.0
              active_intervals = []

              for x, y_start, y_end, typ in events:
                  # Calculate the height of the union of intervals at the previous x point
                  if last_x is not None:
                      height = 0
                      current_y = -1
                      for y1, y2 in active_intervals:
                          current_y = max(current_y, y1)
                          height += max(0, y2 - current_y)
                          current_y = max(current_y, y2)
                      total_area += height * (x - last_x)
                
                  if typ == 1:
                      active_intervals.append((y_start, y_end))
                      active_intervals.sort()
                  else:
                      active_intervals.remove((y_start, y_end))

                  last_x = x

              return total_area

          # Binary search to find the dividing line
          total_area = calculate_area(float('inf'))  # Calculate total area assuming all squares are cut off at y = inf
          low, high = 0.0, 10 ** 9
          while high - low > 1e-5:
              mid = (low + high) / 2
              if calculate_area(mid) * 2 >= total_area:
                  high = mid
              else:
                  low = mid

          return low

      ]
