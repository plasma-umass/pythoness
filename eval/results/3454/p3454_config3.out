       def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.

          The function should pass the following tests:
              separateSquares(squares = [[0,0,1],[2,2,1]]) == 1.00000
              separateSquares(squares = [[0,0,2],[1,1,1]]) == 1.00000
          """

          # Binary Search for the correct y-coordinate line
          def is_valid(mid_y: float) -> bool:
              # Check if a horizontal line at mid_y divides the squares into two equal areas

              total_above = 0
              total_below = 0

              for x, y, l in squares:
                  bottom = y
                  top = y + l

                  # Fully above the line
                  if bottom >= mid_y:
                      total_above += l * l
                  # Fully below the line
                  elif top <= mid_y:
                      total_below += l * l
                  else:
                      # Partly above and partly below the line
                      above_area = (top - mid_y) * l
                      below_area = (mid_y - bottom) * l
                      total_above += above_area
                      total_below += below_area

              # Check if the areas are balanced within tolerance
              return abs(total_above - total_below) <= 1e-5

          # Binary search for the y-coordinate
          low = min(y for _, y, _ in squares)
          high = max(y + l for _, y, l in squares)

          while high - low > 1e-5:
              mid = (low + high) / 2
              if is_valid(mid):
                  return mid
              elif total_below > total_above:
                  high = mid
              else:
                  low = mid

          return (low + high) / 2
      ]
