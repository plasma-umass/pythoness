      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """

          from bisect import bisect_left
          from collections import defaultdict

          # Allocate events for entering and leaving the sweep line
          events = []
          area_map = defaultdict(int)

          for x, y, l in squares:
              events.append((y, x, x + l, 1))  # square enters at y
              events.append((y + l, x, x + l, -1))  # square leaves at y + l

          # Sort events by y-coordinate
          events.sort()

          active_intervals = []
          prev_y = events[0][0]
          total_area = 0

          for curr_y, x1, x2, type in events:
              # Calculate covered area between prev_y and curr_y
              coverage = 0
              last_x = -1

              for start, end in active_intervals:
                  last_x = max(last_x, start)
                  coverage += max(0, end - last_x)
                  last_x = max(last_x, end)

              # Add area covered between prev_y and curr_y to total area
              total_area += coverage * (curr_y - prev_y)

              # Update active intervals based on event type
              if type == 1:
                  active_intervals.append((x1, x2))
                  active_intervals.sort()
              else:
                  active_intervals.remove((x1, x2))

              prev_y = curr_y

          # Binary search to find the y-coordinate that balances the area
          lo, hi = min(events)[0], max(events)[0]
          target_area = total_area / 2

          def compute_area(y_test):
              area = 0
              active_intervals.clear()
              last_y, current_area = 0, 0

              for y, x1, x2, type in events:
                  if y > y_test:
                      break

                  coverage = 0
                  last_x = -1
                  for start, end in active_intervals:
                      last_x = max(last_x, start)
                      coverage += max(0, end - last_x)
                      last_x = max(last_x, end)

                  area += coverage * (y - last_y)

                  if type == 1:
                      active_intervals.append((x1, x2))
                      active_intervals.sort()
                  else:
                      active_intervals.remove((x1, x2))

                  last_y = y

              return area

          while hi - lo > 1e-5:
              mid = (lo + hi) / 2
              if compute_area(mid) < target_area:
                  lo = mid
              else:
                  hi = mid

          return lo

      ]
