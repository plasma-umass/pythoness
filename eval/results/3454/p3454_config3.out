      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.

          The function should pass the following tests:
              separateSquares(squares = [[0,0,1],[2,2,1]]) == 1.00000
              separateSquares(squares = [[0,0,2],[1,1,1]]) == 1.00000
          """
          from typing import List
          from collections import defaultdict

          # Create an event list for the start and end of the vertical segments
          events = []
          for x, y, l in squares:
              events.append((y, x, x + l, 1))  # square start
              events.append((y + l, x, x + l, -1))  # square end

          # Sort events by y-coordinate
          events.sort()

          # Sweep line along y
          area_above = 0
          area_below = 0
          current_y = events[0][0]
          active_intervals = defaultdict(int)
          total_area = 0

          for y, x_start, x_end, typ in events:
              # Calculate the total length of active intervals
              current_x = -1
              length = 0
              for x in sorted(active_intervals):
                  if active_intervals[x] > 0:
                      length += max(0, x - current_x)
                      current_x = max(current_x, x)

              # Sum rectangle areas
              total_area += length * (y - current_y)

              # If areas are equal, return the current_y
              half_area = total_area / 2.0
              if abs(area_below - half_area) <= 1e-5:
                  return current_y

              if abs(area_above - half_area) <= 1e-5:
                  return y

              # Distribute area based on y level
              if y > current_y:
                  area_below += length * (y - current_y)

              # Update current y-level
              current_y = y

              # Update active segments
              active_intervals[x_start] += typ
              active_intervals[x_end] -= typ

          return current_y

      ]
