      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.

          """
          from typing import List
          import itertools

          # Collect all unique potential y-values (bottom and top edges)
          y_values = set(itertools.chain.from_iterable((yi, yi + li) for _, yi, li in squares))

          # Sort y-values
          sorted_y = sorted(y_values)

          def calculate_area_below(y_line):
              """ Calculate the total area covered by squares below the horizontal line at y_line. """
              total_area = 0
              for xi, yi, li in squares:
                  if yi < y_line:
                      # Calculate the part of the square that is below the y_line
                      effective_height = min(li, max(0, y_line - yi))
                      total_area += li * effective_height
              return total_area

          total_area = sum(li * li for _, _, li in squares)
          target_area = total_area / 2

          low, high = 0, len(sorted_y) - 1
          while high - low > 1e-6:
              mid = (low + high) / 2
              mid_y = (sorted_y[int(mid)] + sorted_y[int(mid) + 1]) / 2
              area_below = calculate_area_below(mid_y)
              if area_below < target_area:
                  low = mid
              else:
                  high = mid

          # Return the y-value which approximately splits the total area
          return (sorted_y[int(low)] + sorted_y[int(low) + 1]) / 2

      ]
