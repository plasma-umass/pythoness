      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """
          from typing import List

          # Prepare the events for sweeping line
          events = []
          for x, y, l in squares:
              # Add event when square starts
              events.append((y, x, x + l, 1))  # (y_coord, x_start, x_end, type=1 for entering)
              # Add event when square ends
              events.append((y + l, x, x + l, -1))  # (y_coord, x_start, x_end, type=-1 for leaving)

          # Sort events by y-coordinate
          events.sort()

          # Total area covered with respecting x-coordinates intervals
          def measure_area(active_intervals):
              active_intervals.sort()
              total_length = 0
              current_start, current_end = -1, -1
              for start, end in active_intervals:
                  if start > current_end:
                      total_length += current_end - current_start
                      current_start, current_end = start, end
                  else:
                      current_end = max(current_end, end)
              total_length += current_end - current_start
              return total_length

          total_area = 0.0
          prev_y = 0.0
          active_intervals = []

          for y, x_start, x_end, typ in events:
              # Calculate the area contribution from the previous y level to the current
              total_area += measure_area(active_intervals) * (y - prev_y)
              prev_y = y

              # Update active intervals
              if typ == 1:
                  active_intervals.append((x_start, x_end))
              else:
                  active_intervals.remove((x_start, x_end))

          # Find dividing y-line
          half_area = total_area / 2.0
          current_area = 0.0
          prev_y = 0.0
          active_intervals = []

          for y, x_start, x_end, typ in events:
              area_contribution = measure_area(active_intervals) * (y - prev_y)

              if current_area + area_contribution > half_area:
                  break

              current_area += area_contribution
              prev_y = y

              if typ == 1:
                  active_intervals.append((x_start, x_end))
              else:
                  active_intervals.remove((x_start, x_end))

          # When the exact y was surpassed
          y_line = prev_y + (half_area - current_area) / measure_area(active_intervals)

          return y_line

      ]
