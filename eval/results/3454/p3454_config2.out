          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """
          from typing import List
          from collections import defaultdict
    
          # To find the minimum y-coordinate of a horizontal line such that the area above equals below,
          # we need a way to compute area swept by a horizontal sweep line.
    
          # First, sort all unique y-coordinates (start and end of squares)
          y_coords = set()
          for x, y, l in squares:
              y_coords.add(y)
              y_coords.add(y + l)
          y_coords = sorted(y_coords)
    
          # A dictionary to keep track of active x-intervals
          x_intervals = defaultdict(int)

          # Function to compute area covered by the activated x_intervals
          def compute_area():
              active_x_intervals = sorted([k for k, v in x_intervals.items() if v > 0])
              total_x_coverage = 0
              last_x = None
              for x in active_x_intervals:
                  if last_x is not None and x > last_x:
                      total_x_coverage += x - last_x
                  last_x = x
              return total_x_coverage

          # Total unique area across all squares
          total_area = 0
          previous_y = None

          for y in y_coords:
              if previous_y is not None:
                  # Calculate the swept area since last y
                  height = y - previous_y
                  total_area += compute_area() * height

              # Update x-intervals
              for x, y_start, l in squares:
                  if y_start <= y < y_start + l:
                      for x_pos in range(x, x + l):
                          x_intervals[x_pos] += 1
                  if y >= y_start + l:
                      for x_pos in range(x, x + l):
                          x_intervals[x_pos] -= 1

              previous_y = y

          # Binary search to find the exact line
          left, right = 0, max(y + l for _, y, l in squares)

          def area_below(y_cut):
              x_ints = defaultdict(int)
              prev_y = None
              area_below_cut = 0
              for y in y_coords:
                  if y >= y_cut:
                      break
                  if prev_y is not None:
                      height = y - prev_y
                      area_below_cut += compute_area() * height

