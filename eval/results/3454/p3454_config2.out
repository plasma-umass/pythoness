       def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """
          # Calculate total unique area covered by all squares
          events = []
          for x, y, l in squares:
              events.append((y, x, x + l, 1))  # square starts
              events.append((y + l, x, x + l, -1))  # square ends

          from collections import defaultdict
          events.sort()

          # Sweep line to calculate unique area
          previous_y = total_area = 0
          current_intervals = defaultdict(int)
          current_length = 0

          for y, x_start, x_end, typ in events:
              # Update total unique area
              total_area += current_length * (y - previous_y)

              # Update active intervals
              for x in range(x_start, x_end):
                  current_intervals[x] += typ

              # Calculate currently covered length
              current_length = sum(1 for v in current_intervals.values() if v > 0)
              previous_y = y

          # Perform a binary search for the line height
          left, right = 0, max(y + l for _, y, l in squares)

          def calculate_area_below(height):
              active_length = default_imports = 0
              prior_y = 0
              result = 0
              for y, x_start, x_end, typ in events:
                  if y >= height:
                      break
                  result += active_length * (y - prior_y)

                  for x in range(x_start, x_end):
                      default_imports += typ

                  active_length = sum(1 for v in current_intervals.values() if v > 0)
                  prior_y = y
              return result

          while right - left > 1e-6:
              mid = (left + right) / 2
              area_below = calculate_area_below(mid)

              if area_below * 2 < total_area:
                  left = mid
              else:
                  right = mid

          return round(left, 5)
      ]
