      from typing import List

      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """
          from itertools import chain

          # Find the vertical segments (y and y + l) of each square
          vertical_segments = list(chain.from_iterable(((y, y+l) for _, y, l in squares)))

          # Sort and deduplicate to find unique y positions
          sorted_unique_y = sorted(set(vertical_segments))

          def calculate_total_area(y_line):
              total_area = 0
              for x, y, l in squares:
                  # Calculate overlap of the square with y_line
                  if y_line >= y + l:
                      # Fully above
                      total_area += 0
                  elif y_line <= y:
                      # Fully below
                      total_area += l * l
                  else:
                      # Partially above
                      part_above = y + l - y_line
                      total_area += (l * l) - (part_above * l)
              return total_area

          # Total area of squares
          total_area = sum(l * l for _, _, l in squares)

          # Binary search to find the y_line where area above equals area below
          low, high = 0, len(sorted_unique_y) - 1
          while low < high:
              mid = (low + high) // 2
              line = sorted_unique_y[mid]
              area_above_line = calculate_total_area(line)
              area_below_line = total_area - area_above_line
              if abs(area_above_line - area_below_line) <= 1e-5:
                  return round(line, 5)
              elif area_above_line > area_below_line:
                  # Move the line downward
                  high = mid
              else:
                  # Move the line upward
                  low = mid + 1

          return round(sorted_unique_y[low], 5)

      ]
