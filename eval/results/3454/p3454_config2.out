      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """
          from typing import List

          # Function to calculate the total covered area above a certain y-coordinate
          def calculateAreaAbove(y_line):
              total_area = 0
              active_intervals = []
              for x, y, l in squares:
                  if y >= y_line + l or y + l <= y_line:
                      continue
                  top = min(y + l, y_line + l)
                  bottom = max(y, y_line)
                  current_area = (top - bottom) * l
                  active_intervals.append((x, x + l, current_area))
              # Sort intervals based on x, and apply a line sweep to calculate union area
              active_intervals.sort()
              current_x = -1
              current_total_height = 0
              current_start = -1
              for x_start, x_end, area in active_intervals:
                  if x_start > current_x:
                      total_area += current_total_height * (x_start - current_x)
                      current_x = x_start
                      current_total_height = 0
                  if x_end > current_x:
                      if current_total_height == 0:
                          current_start = x_start
                      current_total_height += area
                      current_x = x_end
              total_area += current_total_height * (current_x - current_start)
              return total_area

          # Binary search for the optimal y-coordinate
          low, high = min((y for _, y, _ in squares)), max((y + l for _, y, l in squares))
          target_area = sum(l * l for _, _, l in squares) / 2

          while high - low > 1e-5:
              mid = (low + high) / 2
              area_above = calculateAreaAbove(mid)
              if area_above >= target_area:
                  high = mid
              else:
                  low = mid

          return round((low + high) / 2, 5)

      ]
