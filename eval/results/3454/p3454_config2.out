                      if y >= y_start + l:
                          for x_pos in range(x, x + l):
                              x_ints[x_pos] -= 1

                  prev_y = y
              return area_below_cut

          total_area /= 2

          while right - left > 1e-6:
              mid = (left + right) / 2
              if area_below(mid) < total_area:
                  left = mid
              else:
                  right = mid
    
          return round(left, 5)
      ]
