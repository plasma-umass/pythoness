          import itertools

          # Find all unique y-coordinates on which to test the line.
          y_coordinates = set(itertools.chain.from_iterable(
              (yi, yi + li) for _, yi, li in squares
          ))
          y_sorted = sorted(y_coordinates)

          def area_up_to(y_limit):
              """
              Calculate the total area up to a given y_limit.
              """
              total_area = 0
              for xi, yi, li in squares:
                  if yi >= y_limit:
                      continue
                  overlap = max(0, min(li, y_limit - yi))
                  total_area += li * overlap
              return total_area

          total_area = area_up_to(float('inf'))
          target_area = total_area / 2.0

          # Perform a binary search for the correct y that divides the area
          left, right = 0, len(y_sorted) - 1
          while left < right:
              mid = (left + right) // 2
              mid_y = y_sorted[mid]
              if area_up_to(mid_y) < target_area:
                  left = mid + 1
              else:
                  right = mid

          return float(y_sorted[left])

      ]
