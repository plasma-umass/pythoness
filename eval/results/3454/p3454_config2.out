      def separateSquares(squares: List[List[int]]) -> float:
          """
          Determines the minimum y-coordinate of a horizontal line that balances the area covered by squares above and below it.
          Each square is represented by its bottom-left corner coordinates and side length, with overlapping areas counted once.
          The algorithm accepts solutions with a precision within 10^-5 of the actual answer.
          """
          from typing import List
          from itertools import chain

          def calculate_areas(y_coord: float) -> float:
              area_above = 0.0
              area_below = 0.0

              for x, y, length in squares:
                  y_top = y + length
                  if y_coord < y:
                      area_above += length * length
                  elif y_coord > y_top:
                      area_below += length * length
                  else:
                      area_above += (y_top - y_coord) * length
                      area_below += (y_coord - y) * length

              return area_below, area_above

          y_min = min(y for _, y, _ in squares)
          y_max = max(y + length for _, y, length in squares)

          tolerance = 1e-5
          while (y_max - y_min) > tolerance:
              y_mid = (y_max + y_min) / 2.0
              area_below, area_above = calculate_areas(y_mid)

              if area_below < area_above:
                  y_min = y_mid
              else:
                  y_max = y_mid

          return round((y_max + y_min) / 2.0, 10)

      ]
