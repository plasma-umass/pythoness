      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """
    
          from typing import List
          import sortedcontainers

          # Helper function to calculate the total area coverage of squares with a minimum y threshold
          def calculate_total_area(y_min_threshold):
              events = []
              for x, y, l in squares:
                  if y + l > y_min_threshold:
                      events.append((x, y_min_threshold, y + l))  # start event for the top side of the square if it's above threshold
                      events.append((x + l, y_min_threshold, y + l, True))  # end event
              events.sort()

              active = sortedcontainers.SortedList()
              previous_x = -1
              total_area = 0

              for event in events:
                  current_x, y_start, y_end, is_end = (event + (False,))[:4]

                  # Calculate total area contributed by the active intervals up to current x
                  if active and current_x != previous_x:
                      total_height = 0
                      previous_y = -1
                      for y1, y2 in active:
                          total_height += max(0, y2 - max(previous_y, y1))
                          previous_y = max(previous_y, y2)

                      total_area += total_height * (current_x - previous_x)

                  # Add or remove active interval depending on event type
                  if not is_end:
                      active.add((y_start, y_end))
                  else:
                      active.remove((y_start, y_end))

                  previous_x = current_x

              return total_area

          total_square_area = calculate_total_area(-1)

          # Perform binary search to find the minimum y-coordinate
          low, high = 0, max(y + l for _, y, l in squares)  # Set high to maximum possible y-coordinate to gauge
          while high - low > 1e-5:
              mid = low + (high - low) / 2
              if calculate_total_area(mid) * 2 >= total_square_area:
                  high = mid
              else:
                  low = mid

          return low

      ]
