      @given(st.lists(st.tuples(st.integers(0, 10**9), st.integers(0, 10**9), st.integers(1, 10**9)), min_size=1, max_size=5*10**4))
      def property_test_result_within_squares_bounds(squares):
          """
          Test that the resulting y-coordinate is within the bounds of y-coordinates of given squares.
          """
          result = separateSquares(squares)
          y_min = min(y for _, y, _ in squares)
          y_max = max(y + l for _, y, l in squares)
          # Result should be within the min and max y values
          assert y_min <= result <= y_max]
