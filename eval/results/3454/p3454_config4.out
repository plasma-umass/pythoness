      @given(st.lists(st.tuples(st.integers(0, 10**9), st.integers(0, 10**9), st.integers(1, 10**9)), min_size=1, max_size=5*10**4))
      def property_test_area_sum(squares):
          """
          Test that the sum of areas of squares on both sides of the line is nearly equal.
          """
          result = separateSquares(squares)
          area_above = sum((x_end - x_start) * (y_end - result) for (x_start, result, y_end, _) in squares if y_end > result)
          area_below = sum((x_end - x_start) * (result - y_start) for (x_start, y_start, result, _) in squares if y_start < result)
          # The areas should be approximately equal
          assert abs(area_above - area_below) <= 10**-5]
