          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """

          from typing import List

          events = []
          for x, y, l in squares:
              # Adding start and end of a square in the events list
              events.append((y, l**2)) # Area when starting
              events.append((y + l, -l**2)) # Negative area when ending

          events.sort()  # Sort events by y coordinate

          total_area = sum(l**2 for _, _, l in squares)
          half_area = total_area / 2

          current_area = 0
          last_y = 0

          for y, area_change in events:
              delta_y = y - last_y
              if current_area + delta_y * total_area >= half_area:
                  return last_y + (half_area - current_area) / total_area

              current_area += delta_y * total_area
              total_area += area_change
              last_y = y

          return last_y
      ]
