      def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """
          from typing import List
          from itertools import chain

          def calculate_area(y_line: float) -> float:
              events = []
              for x, y, l in squares:
                  if y < y_line < y + l:
                      events.append((x, max(y, y_line), True))
                      events.append((x + l, max(y, y_line), False))
                  elif y >= y_line:
                      events.append((x, y, True))
                      events.append((x + l, y, False))

              events.sort()

              active_intervals = []
              last_x = events[0][0]
              total_area = 0.0

              for x, y_bottom, is_start in events:
                  length = x - last_x
                  if length > 0:
                      width = 0
                      active_intervals.sort()
                      current_bottom = active_intervals[0][0] if active_intervals else 0
                      for y1, y2 in active_intervals:
                          width += max(0, y2 - max(y1, current_bottom))
                          current_bottom = max(current_bottom, y2)
                      total_area += width * length
                  if is_start:
                      active_intervals.append((y_bottom, y_bottom + y_line))
                  else:
                      active_intervals.remove((y_bottom, y_bottom + y_line))
                  last_x = x

              return total_area

          total_square_area = calculate_area(0)
          low, high = 0, max(yi + li for _, yi, li in squares)

          while high - low > 1e-5:
              mid = (high + low) / 2
              if calculate_area(mid) * 2 >= total_square_area:
                  high = mid
              else:
                  low = mid

          return low

      ]
