      [[Pythoness] Synthesized function: 
       def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """

          from typing import List

          events = []
          total_area = 0

          for x, y, l in squares:
              # Collecting start and end of square regions vertically
              events.append((y, x, x + l, 1))  # 1 for entering a square
              events.append((y + l, x, x + l, -1))  # -1 for leaving a square
              total_area += l * l  # Calculate total area

          events.sort()  # Sort events by y coordinate

          current_area = 0
          last_y = events[0][0]
          active = []

          def calculate_union(intervals):
              """Calculate union length of non-overlapping intervals"""
              intervals.sort()
              total_length, current_start, current_end = 0, -1, -1
              for start, end in intervals:
                  if start > current_end:
                      total_length += current_end - current_start
                      current_start, current_end = start, end
                  else:
                      current_end = max(current_end, end)
              total_length += current_end - current_start
              return total_length

          for y, x_start, x_end, typ in events:
              if y != last_y:
                  # Calculate current covered area by active intervals
                  union_length = calculate_union(active)
                  current_area += union_length * (y - last_y)
                  last_y = y
                  if current_area * 2 == total_area:
                      return float(y)

              # Add or remove square sides from active list
              if typ == 1:
                  active.append((x_start, x_end))
              else:
                  active.remove((x_start, x_end))

          return float(last_y)
      ]
