       def separateSquares(squares: List[List[int]]) -> float:
          """
          You are given a 2D integer array squares. Each squares[i] = [xi, yi, li] represents the coordinates of the bottom-left point and the side length of a square parallel to the x-axis.
          Find the minimum y-coordinate value of a horizontal line such that the total area covered by squares above the line equals the total area covered by squares below the line.
          Answers within 10^-5 of the actual answer will be accepted.
          Note: Squares may overlap. Overlapping areas should be counted only once in this version.

          Constraints:

          1 <= squares.length <= 5 * 10^4
          squares[i] = [xi, yi, li]
          squares[i].length == 3
          0 <= xi, yi <= 10^9
          1 <= li <= 10^9
          The total area of all the squares will not exceed 10^15.
          """

          from typing import List
          from collections import defaultdict

          def calculate_covered_area(squares: List[List[int]], y_line: float) -> float:
              covered_intervals = defaultdict(int)

              for x, y, l in squares:
                  if y + l <= y_line:
                      continue
                  if y >= y_line:
                      covered_intervals[(x, x + l)] += (l * 1)
                  else:
                      intersect_length = y + l - y_line
                      covered_intervals[(x, x + l)] += intersect_length

              total_covered = 0.0
              for (x1, x2), h in covered_intervals.items():
                  total_covered += (x2 - x1) * h

              return total_covered

          total_area = calculate_covered_area(squares, float('inf'))

          def area_difference(y_line: float) -> float:
              covered_area = calculate_covered_area(squares, y_line)
              return 2 * covered_area - total_area

          low, high = 0.0, max([y + l for _, y, l in squares])
          epsilon = 1e-5

          while high - low > epsilon:
              mid = (low + high) / 2
              if area_difference(mid) >= 0:
                  high = mid
              else:
                  low = mid

          return (low + high) / 2
      ]
