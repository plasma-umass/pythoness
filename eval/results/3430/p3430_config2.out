      [[Pythoness] Synthesized function: 
       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def calculate_sum(n, k):
              total_sum = 0

              for sub_size in range(1, k + 1):
                  min_deque = deque()
                  max_deque = deque()

                  for i in range(sub_size):
                      while min_deque and nums[min_deque[-1]] >= nums[i]:
                          min_deque.pop()
                      while max_deque and nums[max_deque[-1]] <= nums[i]:
                          max_deque.pop()
                      min_deque.append(i)
                      max_deque.append(i)

                  total_sum += nums[min_deque[0]] + nums[max_deque[0]]

                  for i in range(sub_size, n):
                      if min_deque and min_deque[0] <= i - sub_size:
                          min_deque.popleft()
                      if max_deque and max_deque[0] <= i - sub_size:
                          max_deque.popleft()

                      while min_deque and nums[min_deque[-1]] >= nums[i]:
                          min_deque.pop()
                      while max_deque and nums[max_deque[-1]] <= nums[i]:
                          max_deque.pop()

                      min_deque.append(i)
                      max_deque.append(i)

                      total_sum += nums[min_deque[0]] + nums[max_deque[0]]

              return total_sum

          n = len(nums)
          return calculate_sum(n, k)
      ]
