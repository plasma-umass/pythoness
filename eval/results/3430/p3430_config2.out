       def minMaxSubarraySum(nums, k):
          """Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          n = len(nums)
          total_sum = 0
    
          for size in range(1, k + 1):
              min_deque, max_deque = [], []
        
              for i in range(size):
                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()
                  min_deque.append(i)
            
                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()
                  max_deque.append(i)

              total_sum += nums[min_deque[0]] + nums[max_deque[0]]

              for i in range(size, n):
                  if min_deque and min_deque[0] <= i - size:
                      min_deque.pop(0)
                  if max_deque and max_deque[0] <= i - size:
                      max_deque.pop(0)

                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()
                  min_deque.append(i)
            
                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()
                  max_deque.append(i)

                  total_sum += nums[min_deque[0]] + nums[max_deque[0]]

          return total_sum
      ]
