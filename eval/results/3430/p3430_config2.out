      [[Pythoness] Synthesized function: 
       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with
          at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def sum_min_max(arr: List[int]) -> int:
              min_deque, max_deque = deque(), deque()
              min_sum, max_sum = 0, 0

              for i in range(len(arr)):
                  while min_deque and arr[min_deque[-1]] >= arr[i]:
                      min_deque.pop()
                  while max_deque and arr[max_deque[-1]] <= arr[i]:
                      max_deque.pop()
                  min_deque.append(i)
                  max_deque.append(i)

                  if min_deque[0] <= i - k:
                      min_deque.popleft()
                  if max_deque[0] <= i - k:
                      max_deque.popleft()

                  min_sum += arr[min_deque[0]]
                  max_sum += arr[max_deque[0]]

              return min_sum + max_sum

          total_sum = 0
          for length in range(1, k+1):
              total_sum += sum_min_max(nums[:length])

          return total_sum
      ]
