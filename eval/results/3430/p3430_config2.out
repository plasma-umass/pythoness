      [[Pythoness] Synthesized function: 
       def minMaxSubarraySum(nums, k):
          """Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def compute_min_max_sum(arr, window_size):
              min_deque, max_deque = deque(), deque()
              current_sum = 0

              for i in range(len(arr)):
                  if min_deque and min_deque[0] <= i - window_size:
                      min_deque.popleft()
                  if max_deque and max_deque[0] <= i - window_size:
                      max_deque.popleft()

                  while min_deque and arr[min_deque[-1]] >= arr[i]:
                      min_deque.pop()
                  while max_deque and arr[max_deque[-1]] <= arr[i]:
                      max_deque.pop()

                  min_deque.append(i)
                  max_deque.append(i)

                  if i >= window_size - 1:
                      current_sum += arr[min_deque[0]] + arr[max_deque[0]]

              return current_sum

          total_sum = 0
          for size in range(1, k + 1):
              total_sum += compute_min_max_sum(nums, size)

          return total_sum
      ]
