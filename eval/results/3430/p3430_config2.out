          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def window_min_max_sum(nums, length):
              min_sum = 0
              max_sum = 0
              min_queue = deque()
              max_queue = deque()

              for i in range(len(nums)):
                  if min_queue and min_queue[0] <= i - length:
                      min_queue.popleft()
                  if max_queue and max_queue[0] <= i - length:
                      max_queue.popleft()

                  while min_queue and nums[min_queue[-1]] >= nums[i]:
                      min_queue.pop()
                  while max_queue and nums[max_queue[-1]] <= nums[i]:
                      max_queue.pop()

                  min_queue.append(i)
                  max_queue.append(i)

                  if i >= length - 1:
                      min_sum += nums[min_queue[0]]
                      max_sum += nums[max_queue[0]]

              return min_sum + max_sum

          total_sum = 0
          for current_k in range(1, k + 1):
              total_sum += window_min_max_sum(nums, current_k)

          return total_sum
      ]
