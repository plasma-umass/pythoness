       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def sumMinMax(window: deque) -> int:
              # Helper function to find the sum of min and max in the current window
              if not window:
                  return 0
              return min(window) + max(window)

          total_sum = 0

          for window_size in range(1, k+1):
              min_deque, max_deque = deque(), deque()
              for i in range(len(nums)):
                  # remove indices which are not in this window
                  if min_deque and min_deque[0] <= i - window_size:
                      min_deque.popleft()
                  if max_deque and max_deque[0] <= i - window_size:
                      max_deque.popleft()

                  # maintain the increasing order for min_deque
                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()
                  # maintain the decreasing order for max_deque
                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()

                  min_deque.append(i)
                  max_deque.append(i)

                  # include sum of min and max in the current valid window
                  if i >= window_size - 1:
                      total_sum += nums[min_deque[0]] + nums[max_deque[0]]

          return total_sum
      ]
