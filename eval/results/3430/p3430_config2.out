       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque
    
          n = len(nums)
          total_sum = 0
    
          for length in range(1, k + 1):
              min_deque = deque()
              max_deque = deque()
        
              # Initialize deques for the first 'length' elements
              for i in range(length):
                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()
                  min_deque.append(i)

                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()
                  max_deque.append(i)

              total_sum += nums[min_deque[0]] + nums[max_deque[0]]

              # Process remaining elements
              for i in range(length, n):
                  # Remove elements not within the current window
                  while min_deque and min_deque[0] <= i - length:
                      min_deque.popleft()
                  while max_deque and max_deque[0] <= i - length:
                      max_deque.popleft()

                  # Add new elements
                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()
                  min_deque.append(i)

                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()
                  max_deque.append(i)

                  total_sum += nums[min_deque[0]] + nums[max_deque[0]]

          return total_sum
      ]
