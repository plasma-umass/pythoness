       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def sum_of_min_max_subarrays(arr, max_size):
              total_sum = 0
              n = len(arr)

              for size in range(1, max_size + 1):
                  min_deque, max_deque = deque(), deque()

                  for i in range(size):
                      while min_deque and arr[min_deque[-1]] >= arr[i]:
                          min_deque.pop()
                      while max_deque and arr[max_deque[-1]] <= arr[i]:
                          max_deque.pop()
                      min_deque.append(i)
                      max_deque.append(i)

                  total_sum += arr[min_deque[0]] + arr[max_deque[0]]

                  for i in range(size, n):
                      # Remove elements not part of this window
                      while min_deque and min_deque[0] <= i - size:
                          min_deque.popleft()
                      while max_deque and max_deque[0] <= i - size:
                          max_deque.popleft()

                      # Add new element
                      while min_deque and arr[min_deque[-1]] >= arr[i]:
                          min_deque.pop()
                      while max_deque and arr[max_deque[-1]] <= arr[i]:
                          max_deque.pop()

                      min_deque.append(i)
                      max_deque.append(i)

                      total_sum += arr[min_deque[0]] + arr[max_deque[0]]

              return total_sum

          return sum_of_min_max_subarrays(nums, k)
      ]
