      [[Pythoness] Synthesized function: 
       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def subarray_min_max_sum(nums, k):
              n = len(nums)
              max_sum = 0
              min_sum = 0

              # Deque to store indices of useful elements of current window of size at most k
              max_deque = deque()
              min_deque = deque()

              # Process all elements of the array
              for i in range(n):
                  # Remove elements no longer within the window
                  if max_deque and max_deque[0] < i - k + 1:
                      max_deque.popleft()
                  if min_deque and min_deque[0] < i - k + 1:
                      min_deque.popleft()

                  # Remove elements that are not useful from rear i.e.,
                  # remove elements smaller than the current element
                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()
                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()

                  # Add current element at the rear of both deques
                  max_deque.append(i)
                  min_deque.append(i)

                  # Calculate the sum for all subarrays ending at index i with length at most k
                  for j in range(max(i - k + 1, 0), i + 1):
                      max_el = nums[max_deque[0]]
                      min_el = nums[min_deque[0]]
                      max_sum += max_el
                      min_sum += min_el

              return max_sum + min_sum

          return subarray_min_max_sum(nums, k)
      ]
