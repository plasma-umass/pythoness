      [[Pythoness] Synthesized function: 
       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def calculate_min_max_for_k_subarrays(nums, length):
              n = len(nums)
              total_sum = 0
              max_deque = deque()
              min_deque = deque()

              for i in range(n):
                  # Remove elements not within the window
                  if max_deque and max_deque[0] < i - length + 1:
                      max_deque.popleft()
                  if min_deque and min_deque[0] < i - length + 1:
                      min_deque.popleft()

                  # Maintain deques for max and min calculations
                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()
                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()

                  max_deque.append(i)
                  min_deque.append(i)

                  if i >= length - 1:
                      max_el = nums[max_deque[0]]
                      min_el = nums[min_deque[0]]
                      total_sum += max_el + min_el

              return total_sum

          n = len(nums)
          total = 0

          # Calculate sum of min and max for all subarrays with size 1 to k
          for length in range(1, k + 1):
              total += calculate_min_max_for_k_subarrays(nums, length)

          return total
      ]
