      [[Pythoness] Synthesized function: 
       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          n = len(nums)
          total_sum = 0

          for window_size in range(1, k+1):
              min_deque, max_deque = deque(), deque()
              current_min_sum, current_max_sum = 0, 0

              for i in range(n):
                  # Remove front elements outside the current window
                  if min_deque and min_deque[0] == i - window_size:
                      current_min_sum -= nums[min_deque.popleft()]
                  if max_deque and max_deque[0] == i - window_size:
                      current_max_sum -= nums[max_deque.popleft()]

                  # Maintain deque for minimum in current window
                  while min_deque and nums[min_deque[-1]] > nums[i]:
                      current_min_sum -= nums[min_deque.pop()]
                  min_deque.append(i)
                  current_min_sum += nums[i]

                  # Maintain deque for maximum in current window
                  while max_deque and nums[max_deque[-1]] < nums[i]:
                      current_max_sum -= nums[max_deque.pop()]
                  max_deque.append(i)
                  current_max_sum += nums[i]

                  # If current subarray size is equal to the window size, compute result
                  if i >= window_size - 1:
                      total_sum += nums[min_deque[0]] + nums[max_deque[0]]

          return total_sum]
