       def minMaxSubarraySum(nums: List[int], k: int) -> int:
          """
          Calculate the sum of the maximum and minimum elements of all subarrays with at most k elements from an integer array nums.

          Constraints:
          1 <= nums.length <= 80000, 1 <= k <= nums.length, and -10^6 <= nums[i] <= 10^6.
          """
          from collections import deque

          def get_min_max_sum(nums, length):
              n = len(nums)
              total_min_max_sum = 0
              max_deque = deque()
              min_deque = deque()

              for i in range(n):
                  # Maintain the deque for max elements of the current window
                  if max_deque and max_deque[0] < i - length + 1:
                      max_deque.popleft()
                  while max_deque and nums[max_deque[-1]] <= nums[i]:
                      max_deque.pop()
                  max_deque.append(i)

                  # Maintain the deque for min elements of the current window
                  if min_deque and min_deque[0] < i - length + 1:
                      min_deque.popleft()
                  while min_deque and nums[min_deque[-1]] >= nums[i]:
                      min_deque.pop()
                  min_deque.append(i)

                  # Only calculate the sum once we hit the window size
                  if i >= length - 1:
                      total_min_max_sum += nums[max_deque[0]] + nums[min_deque[0]]

              return total_min_max_sum

          total_sum = 0
          # Iterate over each possible subarray length
          for current_length in range(1, k + 1):
              total_sum += get_min_max_sum(nums, current_length)

          return total_sum
      ]
