       def permute(args: dict) -> List[int]:
          """
          Returns the k-th lexicographically sorted alternating permutation of the first n positive integers.
          An alternating permutation ensures no two adjacent elements are both odd or both even.
          If fewer than k valid permutations exist, returns an empty list.
          """
          from itertools import permutations
          n, k = args['n'], args['k']
          nums = list(range(1, n + 1))
          alternating_perms = []

          # Helper function to check if a permutation is alternating
          def is_alternating(perm):
              return all((perm[i] % 2) != (perm[i + 1] % 2) for i in range(n - 1))

          # Generate all permutations and filter alternating ones
          for perm in permutations(nums):
              if is_alternating(perm):
                  alternating_perms.append(perm)
                  if len(alternating_perms) == k:
                      return list(alternating_perms[k - 1])

          return []]
