       def maxDifference(s: str, k: int) -> int:
          """
          Find the maximum difference between the frequency of two characters in a substring of a given string, 
          where one character has an odd frequency and the other an even frequency, and the substring size is 
          at least k. The substring can contain more than two distinct characters, and the input guarantees the 
          presence of at least one such valid substring. This problem is constrained by string lengths ranging 
          from 3 to 30,000, containing only digits from '0' to '4'.
          """
          max_diff = -1
          n = len(s)

          # Iterate over all possible starting points of substrings
          for start in range(n):
              freq = [0] * 5  # To store frequency of each digit from 0 to 4

              # Expand the substring from the starting point
              for end in range(start, n):
                  digit = int(s[end])
                  freq[digit] += 1

                  # Check if the current substring is at least of length k
                  if end - start + 1 >= k:
                      # Calculate the possible odd and even frequencies
                      odd_frequencies = [freq[i] for i in range(5) if freq[i] % 2 == 1]
                      even_frequencies = [freq[i] for i in range(5) if freq[i] % 2 == 0 and freq[i] > 0]

                      if odd_frequencies and even_frequencies:  # Both must be present
                          # Calculate the maximum difference
                          current_max_odd = max(odd_frequencies)
                          current_max_even = max(even_frequencies)
                          current_diff = abs(current_max_odd - current_max_even)
                          max_diff = max(max_diff, current_diff)

          return max_diff
      ]
