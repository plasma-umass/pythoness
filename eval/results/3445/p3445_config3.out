def brute_force_max_difference(s, k):
    from collections import Counter
    n = len(s)
    max_diff = -1
    for start in range(n):
        freq = Counter()
        for end in range(start, n):
            freq[s[end]] += 1
            if end - start + 1 >= k:
                max_even = max((freq[c] for c in freq if freq[c] % 2 == 0), default=0)
                max_odd = max((freq[c] for c in freq if freq[c] % 2 == 1), default=0)
                if max_even > 0 and max_odd > 0:
                    max_diff = max(max_diff, abs(max_even - max_odd))
    return str(max_diff) if max_diff != -1 else "-1"

