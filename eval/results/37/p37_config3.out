      def solveSudoku(board: List[List[str]]) -> None:
          """
          Write a program to solve a Sudoku puzzle by filling the empty cells.
          A sudoku solution must satisfy all of the following rules:

          Each of the digits 1-9 must occur exactly once in each row.
          Each of the digits 1-9 must occur exactly once in each column.
          Each of the digits 1-9 must occur exactly once in each of the 9 3x3 sub-boxes of the grid.

          The '.' character indicates empty cells.

          Constraints:

          board.length == 9
          board[i].length == 9
          board[i][j] is a digit or '.'.
          It is guaranteed that the input board has only one solution.
          """
          def could_place(d: str, row: int, col: int) -> bool:
              blk_index = (row // 3) * 3 + col // 3
              return not (d in rows[row] or d in columns[col] or d in blocks[blk_index])

          def place_number(d: str, row: int, col: int) -> None:
              rows[row].add(d)
              columns[col].add(d)
              blocks[(row // 3) * 3 + col // 3].add(d)
              board[row][col] = d

          def remove_number(d: str, row: int, col: int) -> None:
              rows[row].remove(d)
              columns[col].remove(d)
              blocks[(row // 3) * 3 + col // 3].remove(d)
              board[row][col] = '.'

          def place_next_numbers(row: int, col: int) -> bool:
              if col == N - 1 and row == N - 1:
                  return True
              if col == N - 1:
                  return backtrack(row + 1, 0)
              return backtrack(row, col + 1)

          def backtrack(row=0, col=0) -> bool:
              if board[row][col] == '.':
                  for d in range(1, 10):
                      str_d = str(d)
                      if could_place(str_d, row, col):
                          place_number(str_d, row, col)
                          if place_next_numbers(row, col):
                              return True
                          remove_number(str_d, row, col)
                  return False
              return place_next_numbers(row, col)

          N = 9
          rows = [set() for _ in range(N)]
          columns = [set() for _ in range(N)]
          blocks = [set() for _ in range(N)]
          for r in range(N):
              for c in range(N):
                  if board[r][c] != '.':
                      d = board[r][c]
                      place_number(d, r, c)
          backtrack()
      ]
