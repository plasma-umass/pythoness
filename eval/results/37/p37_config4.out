      @given(st.lists(st.lists(st.text(string.digits[1:], min_size=9, max_size=9), min_size=9, max_size=9)))
      def property_test_2(board):
          """
          Test that puzzle solution still satisfies Sudoku rules
          """
          def check_solution(sol):
              for i in range(9):
                  row = set()
                  column = set()
                  square = set()
                  for j in range(9):
                      if sol[i][j] in row or sol[j][i] in column:
                          return False
                      row.add(sol[i][j])
                      column.add(sol[j][i])
                      square.add(sol[3 * (i // 3) + j // 3][3 * (i % 3) + j % 3])
                  if len(square) != 9:
                      return False
              return True
          solveSudoku(board)
          assert check_solution(board)
