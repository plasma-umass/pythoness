      @given(board=st.lists(st.lists(st.sampled_from('123456789.'), min_size=9, max_size=9), min_size=9, max_size=9))
      def property_test_1(board):
    
          def is_valid_sudoku(board):
        
              def valid_line(lst):
                  nums = [x for x in lst if x != '.']
                  return len(nums) == len(set(nums))
        
              for row in board:
                  if not valid_line(row):
                      return False
        
              for col_idx in range(9):
                  if not valid_line([board[row_idx][col_idx] for row_idx in range(9)]):
                      return False
        
              for box_row in range(3):
                  for box_col in range(3):
                      box = [
                          board[r][c]
                          for r in range(box_row * 3, (box_row + 1) * 3)
                          for c in range(box_col * 3, (box_col + 1) * 3)
                      ]
                      if not valid_line(box):
                          return False
              return True
    
          solveSudoku(board)
          assert is_valid_sudoku(board)]
