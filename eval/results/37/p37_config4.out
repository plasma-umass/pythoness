      @given(st.lists(st.lists(st.sampled_from("123456789."), min_size=9, max_size=9), min_size=9, max_size=9))
      def property_test_2(board):
    
          def count_empty_cells(board):
              return sum(row.count('.') for row in board)
    
          original_empty_cells = count_empty_cells(board)
          solveSudoku(board)
          solved_empty_cells = count_empty_cells(board)
          assert solved_empty_cells == 0
          assert original_empty_cells > solved_empty_cells]
