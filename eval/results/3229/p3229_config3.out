          Constraints:

          1 <= nums.length == target.length <= 10^5
          1 <= nums[i], target[i] <= 10^8
          """
    
          total_difference = 0
          differences = [n - t for n, t in zip(nums, target)]

          # Calculate minimum operations by summing absolute differences
          for diff in differences:
              total_difference += abs(diff)

          return total_difference // 2
      ]
