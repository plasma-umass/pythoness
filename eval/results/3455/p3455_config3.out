      [[Pythoness] Synthesized function: 
       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """
          parts = p.split('*')
          if len(parts) != 3:
              return -1

          prefix, middle, suffix = parts
          n = len(s)
          min_len = float('inf')
          found = False

          for i in range(n):
              if s[i:].startswith(prefix):  # match prefix
                  for j in range(i + len(prefix), n + 1):
                      if s[j:].endswith(suffix):  # match suffix
                          middle_substr = s[i + len(prefix):j - len(suffix) if suffix else j]
                          if middle in middle_substr:  # match middle
                              found = True
                              min_len = min(min_len, j - i)

          return min_len if found else -1
      ]
