       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """
          if p.count('*') != 2:
              return -1

          # Split the pattern on the '*' characters
          p_split = p.split('*')
          prefix, middle, suffix = p_split[0], p_split[1], p_split[2]

          min_length = float('inf')
          found = False

          # Iterate over each possible starting point in the string
          for start in range(len(s)):
              # Check for prefix match
              if not s.startswith(prefix, start):
                  continue

              # Find the end of prefix match
              end_of_prefix = start + len(prefix)

              # Find the middle part in the remaining string
              if middle:
                  middle_start = s.find(middle, end_of_prefix)
                  if middle_start == -1:
                      continue
              else:
                  middle_start = end_of_prefix

              # Find the suffix in the remaining string after middle
              suffix_start = s.find(suffix, middle_start + len(middle))
              if suffix_start == -1:
                  continue

              # Calculate the length of matching substring
              length = suffix_start + len(suffix) - start
              if length < min_length:
                  min_length = length
                  found = True

          return min_length if found else -1
      ]
