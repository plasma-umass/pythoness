       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """
          first_star = p.find('*')
          second_star = p.find('*', first_star + 1)

          if first_star == -1 or second_star == -1:
              return -1

          # Extract prefix, middle, and suffix parts from pattern p
          prefix = p[:first_star]
          middle = p[first_star+1:second_star]
          suffix = p[second_star+1:]
    
          min_length = float('inf')
          found = False

          for i in range(len(s)):
              # Match the prefix
              if not s[i:].startswith(prefix):
                  continue

              # Find the end of the prefix match
              j = i + len(prefix)

              if middle:
                  mid_index = s.find(middle, j)
                  if mid_index == -1:
                      continue
                  j = mid_index + len(middle)

              end_index = s.find(suffix, j)
              if end_index == -1:
                  continue
              length = end_index + len(suffix) - i

              if length < min_length:
                  min_length = length
                  found = True

          return min_length if found else -1
      ]
