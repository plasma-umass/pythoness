       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """
          if p.count('*') != 2:
              return -1

          # Split pattern at '*'
          parts = p.split('*')
          if len(parts) != 3:
              return -1

          start, middle, end = parts
          n = len(s)
          min_length = float('inf')
          found = False

          # Try to find the shortest substring matching the pattern
          for i in range(n):
              # Ensure the substring from current index can start with the pattern's start part
              if s[i:].startswith(start):
                  for j in range(i + len(start), n + 1):
                      # Ensure we can end with the pattern's end part
                      if s[j - len(end):j] == end:
                          # Check if middle part found in between
                          if middle in s[i + len(start):j - len(end)]:
                              found = True
                              min_length = min(min_length, j - i)

          return min_length if found else -1
      ]
