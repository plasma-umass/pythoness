       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """

          # Split the pattern by '*'
          parts = p.split('*')

          if len(parts) != 3:
              return -1

          part1, part2, part3 = parts
          min_length = float('inf')
          found = False

          # Iterate through each possible start of the match
          for start in range(len(s) - len(part1) - len(part3) + 1):
              if s.startswith(part1, start):
                  # Find the position of part2 after part1
                  pos2_start = start + len(part1)
                  pos2 = s.find(part2, pos2_start)
                  while pos2 != -1:
                      # The position for part3 should be after part2
                      pos3_start = pos2 + len(part2)
                      if s.startswith(part3, pos3_start):
                          # Calculate the current matching substring length
                          current_length = pos3_start + len(part3) - start
                          min_length = min(min_length, current_length)
                          found = True
                      # Find the next occurrence of part2
                      pos2 = s.find(part2, pos2 + 1)

          return min_length if found else -1
      ]
