       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """
          import re

          # Escape the patterns for regex and replace '*' with '.*' to match any sequence
          parts = p.split('*')
          if len(parts) != 3:
              return -1

          # The regex pattern, ensuring non-greedy matching by using '.*?' for the stars
          pattern = re.compile(re.escape(parts[0]) + '.*?' + re.escape(parts[1]) + '.*?' + re.escape(parts[2]))

          matches = [match for match in re.finditer(pattern, s)]

          if not matches:
              return -1

          # Find the minimum length among all matches
          min_length = min(len(match.group(0)) for match in matches)

          return min_length]
