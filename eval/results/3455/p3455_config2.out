       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, 
          where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. 
          Return the length of the shortest matching substring, or -1 if no such substring exists. 
          The empty substring is considered valid.
          """
          # Split pattern by '*'
          parts = p.split('*')
          if len(parts) != 3:
              return -1  # Invalid pattern (should have exactly two '*')
    
          prefix, middle, suffix = parts

          # Function to find all starting points for a given pattern part and direction
          def find_starts(s, part, reverse=False):
              starts = []
              start = 0
              while start < len(s):
                  idx = (s if not reverse else s[::-1]).find(part, start)
                  if idx == -1:
                      break
                  starts.append(idx if not reverse else len(s) - 1 - idx - len(part) + 1)
                  start = idx + 1
              return starts

          # Find possible start and end positions for prefix and suffix
          prefix_starts = find_starts(s, prefix)
          suffix_ends = find_starts(s, suffix[::-1], reverse=True)

          if not prefix_starts or not suffix_ends:
              return -1

          # Try to establish the shortest length
          min_length = float('inf')
          for start in prefix_starts:
              for end in suffix_ends:
                  if start <= end and middle in s[start:end + len(suffix)]:
                      min_length = min(min_length, end + len(suffix) - start)

          return min_length if min_length != float('inf') else -1]
