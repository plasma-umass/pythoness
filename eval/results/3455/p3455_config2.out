       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`,
          where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters.
          Return the length of the shortest matching substring or -1 if no such substring exists.
          The empty substring is considered valid.
          """
          # Split pattern into parts
          parts = p.split('*')
          if len(parts) != 3:
              return -1
    
          start_part, middle_part, end_part = parts

          min_length = float('inf')
          n = len(s)

          # Find all valid positions for the start part
          for i in range(n):
              if s.startswith(start_part, i):
                  # Find all valid positions for the end part
                  for j in range(i, n):
                      if s.startswith(end_part, j) and middle_part in s[i:j]:
                          min_length = min(min_length, j + len(end_part) - i)

          return min_length if min_length != float('inf') else -1]
