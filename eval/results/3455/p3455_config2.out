          min_length = float('inf')
          n = len(s)
          start = 0

          while start <= n:
              # Match prefix
              if not (prefix == '' or s.startswith(prefix, start)):
                  start += 1
                  continue

              # Move to end of prefix
              end = start + len(prefix)

              # Match middle
              mid_start = s.find(middle, end)
              if mid_start == -1:
                  start += 1
                  continue

              # Move to end of middle
              mid_end = mid_start + len(middle)

              # Match suffix
              suf_start = s.find(suffix, mid_end)
              if suf_start == -1:
