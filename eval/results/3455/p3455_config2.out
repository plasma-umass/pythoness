       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """
          # Find positions of '*' in the pattern
          try:
              first_star_idx = p.index('*')
              second_star_idx = p.index('*', first_star_idx + 1)
          except ValueError:
              return -1

          # Extract the subpatterns around '*'
          first_part = p[:first_star_idx]
          middle_part = p[first_star_idx + 1:second_star_idx]
          last_part = p[second_star_idx + 1:]

          min_length = float('inf')
          found = False

          # Iterate over the string s
          for i in range(len(s)):
              # Check if the first part matches
              if s.startswith(first_part, i):
                  # Find start position for the middle part
                  start_middle = i + len(first_part)
                  if start_middle > len(s):
                      continue

                  # Search for middle part
                  mid_pos = s.find(middle_part, start_middle)
                  while mid_pos != -1:
                      # Find start position for the last part
                      start_last = mid_pos + len(middle_part)
                      if start_last > len(s):
                          break

                      # Check if the last part matches
                      if s.startswith(last_part, start_last):
                          # Calculate the length of the matching substring
                          end_last = start_last + len(last_part)
                          current_length = end_last - i
                          min_length = min(min_length, current_length)
                          found = True

                      # Move to the next occurrence of middle_part
                      mid_pos = s.find(middle_part, mid_pos + 1)

          return min_length if found else -1
      ]
