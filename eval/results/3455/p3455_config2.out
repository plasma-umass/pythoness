       def shortestMatchingSubstring(s: str, p: str) -> int:
          """
          Find the length of the shortest substring in a given string `s` that matches a pattern `p`, where `p` contains exactly two '*' characters, which can match any sequence of zero or more characters. Return the length of the shortest matching substring or -1 if no such substring exists. The empty substring is considered valid.
          """
          parts = p.split('*')
          if len(parts) != 3:
              return -1  # Malformed pattern as it should split into exactly three parts
          prefix, middle, suffix = parts
          min_length = float('inf')
          found = False
          n = len(s)

          for start in range(n):
              if not s.startswith(prefix, start):
                  continue
              end = start + len(prefix)
              # search for middle pattern
              mid_start = s.find(middle, end)
              if mid_start == -1:
                  continue
              mid_end = mid_start + len(middle)
              # search for suffix pattern
              suf_start = s.find(suffix, mid_end)
              if suf_start == -1:
                  continue
              suf_end = suf_start + len(suffix)
              # Calculate the length of the matching substring
              total_length = suf_end - start
              found = True
              min_length = min(min_length, total_length)

          return min_length if found else -1
      ]
